#!/usr/bin/env bash
# codexbar — OpenAI Codex plan usage widget for Waybar
# Reads OAuth credentials from Codex CLI, shows session/weekly/review limits
# with colored progress bars and Pango markup tooltip.
#
# Usage: codexbar [--help] [--icon ICON] [--format FORMAT] [--tooltip-format FORMAT]
#                 [--pace-tolerance N] [--format-pace-color] [--tooltip-pace-pts] [--remaining]
#                 [--tooltip-font FONT] [--no-color[=all|bar|tooltip]]
#                 [--color-low HEX] [--color-mid HEX] [--color-high HEX] [--color-critical HEX]
#                 [--json] [--refresh]
#
# --help     Print this reference — usage, flags and format placeholders — and
#            exit 0. Also accepted as -h.
# --json     Structured output mode: emits one raw-data JSON object (numbers,
#            ISO-8601 timestamps, state strings — no Pango markup) instead of
#            Waybar JSON. For frontends that render their own UI, e.g. the
#            Omarchy shell plugin in omarchy/. Always exits 0; errors are
#            reported in an "error" field. Carries the resolved gauge anchors
#            in "palette" (theme colors / --color-* overrides) so such a
#            frontend paints the same ramp this script does — the only colors
#            in the payload, and data rather than markup.
#            See README "Structured JSON output".
# --refresh  Bypass the 60s response cache and fetch fresh data from the API
#            (the result still updates the cache for other instances).
# --tooltip-font FONT
#            Font family (or Pango family list) the tooltip is pinned to.
#            Default: "JetBrainsMono Nerd Font Mono, JetBrainsMono Nerd Font,
#            monospace". The tooltip needs a MONOSPACE font: its rules are made
#            of box-drawing characters, which in a proportional font render far
#            wider than letters, so the tooltip sizes itself to the rules and
#            grows a dead margin to the right of the text. Waybar draws the
#            tooltip in a GTK window that ignores font-family from CSS, so the
#            markup is the only place this can be said.
# --frame, --frame-font
#            DEPRECATED, still accepted. --frame drew a bordered card around
#            the tooltip and is now a no-op; --frame-font is an alias for
#            --tooltip-font. The box was a second look for the same content —
#            more code, more docs, more screenshots — and it only aligned when
#            the pinned font was a complete Mono Nerd Font. Pinning the font on
#            the one remaining tooltip gives the alignment without the box.
# --no-color[=all|bar|tooltip]
#            Monochrome output: no color markup on the chosen surface (default
#            "all"). Everything structural stays — glyphs, bar characters,
#            markers, box drawing, bold, layout. The "class" field and the
#            --json payload are unaffected, so CSS remains the way to style a
#            monochrome bar. NO_COLOR=<non-empty> in the environment means
#            --no-color=all; an explicit flag wins over it.
#
# Format placeholders:
#   {icon}              Widget mark, Nerd Font (󱙺)
#   {plan}              Plan label (e.g. "Plus")
#   {session_pct}            Session (5h) usage %
#   {session_remaining_pct}  Session (5h) remaining %
#   {session_reset}          Session countdown (e.g. "1h 30m")
#   {session_elapsed}        Session time elapsed %
#   {session_bar}            Session usage progress bar (Pango-colored)
#   {session_remaining_bar}  Session remaining progress bar (Pango-colored)
#   {session_pace}           Session pacing icon, ratio-based (↑ ↓ →)
#   {session_pace_indicator} Session pacing icon, point-based (↑ ↓ →)
#   {session_pace_pct}       Session pacing deviation, ratio (e.g. "72% ahead")
#   {session_pace_pts}       Session pacing deviation, points (e.g. "12pts ahead")
#   {session_pace_delta}     Session pacing delta, signed (e.g. "-12", "5", "0")
#   {session_pace_abs_delta} Session pacing delta, unsigned (e.g. "12", "5", "0")
#   {weekly_pct}             Weekly usage %
#   {weekly_remaining_pct}   Weekly remaining %
#   {weekly_reset}           Weekly countdown (e.g. "4d 1h")
#   {weekly_elapsed}         Weekly time elapsed %
#   {weekly_bar}             Weekly usage progress bar (Pango-colored)
#   {weekly_remaining_bar}   Weekly remaining progress bar (Pango-colored)
#   {weekly_pace}            Weekly pacing icon, ratio-based (↑ ↓ →)
#   {weekly_pace_indicator}  Weekly pacing icon, point-based (↑ ↓ →)
#   {weekly_pace_pct}        Weekly pacing deviation, ratio (e.g. "72% ahead")
#   {weekly_pace_pts}        Weekly pacing deviation, points (e.g. "12pts ahead")
#   {weekly_pace_delta}      Weekly pacing delta, signed (e.g. "-12", "5", "0")
#   {weekly_pace_abs_delta}  Weekly pacing delta, unsigned (e.g. "12", "5", "0")
#   {review_pct}             Code review usage %
#   {review_remaining_pct}   Code review remaining %
#   {review_reset}           Code review countdown
#   {review_elapsed}         Code review time elapsed %
#   {review_bar}             Code review usage progress bar (Pango-colored)
#   {review_remaining_bar}   Code review remaining progress bar (Pango-colored)
#   {review_pace}            Review pacing icon, ratio-based (↑ ↓ →)
#   {review_pace_indicator}  Review pacing icon, point-based (↑ ↓ →)
#   {review_pace_pct}        Review pacing deviation, ratio (e.g. "72% ahead")
#   {review_pace_pts}        Review pacing deviation, points (e.g. "8pts ahead")
#   {review_pace_delta}      Review pacing delta, signed (e.g. "-8", "3", "0")
#   {review_pace_abs_delta}  Review pacing delta, unsigned (e.g. "8", "3", "0")
#   {credits_balance}   Credits balance
#   {credits_local}     Approx local messages remaining
#   {credits_cloud}     Approx cloud messages remaining
#
# Default format: "{session_pct}% · {session_reset}"
# Note: {session_*} maps to the API's primary rate-limit window and {weekly_*}
#       to the secondary one. When the API exposes a single weekly window
#       (primary ≈ 7 days, secondary null), {weekly_*} mirrors the primary
#       window so both placeholder families report the real weekly usage.
# Note: bar placeholders are colored by their own window's usage, independent of
#       the surrounding bar text color (which reflects the worst window).
# --remaining flips the default bar text + tooltip to a "what's left" framing
#   (e.g. "58% · 1h 30m"); {*_remaining_pct} and {*_remaining_bar} are
#   available regardless of this flag. Fully backward compatible; opt-in.

set -euo pipefail

# Character counting must not depend on the caller's locale. ${#var} counts
# BYTES under a C locale, so every multibyte glyph in the tooltip — the bar
# cells █░, the Nerd Font icons, the box-drawing rules — inflates a line's
# measured width. The rules are drawn to that width, so they end up ~20
# characters longer than the text they underline and the tooltip grows a dead
# margin on its right. Waybar started from a systemd unit with no locale is
# exactly this case. LC_CTYPE alone is the surgical fix: it governs character
# classification, and leaves collation and number formatting to the user.
if [[ "$(locale charmap 2>/dev/null)" != "UTF-8" ]]; then
    # LC_ALL outranks LC_CTYPE, so it has to go first — otherwise the override
    # below is silently ignored. Dropping it here affects only this process.
    unset LC_ALL
    for _loc in C.UTF-8 C.utf8 en_US.UTF-8; do
        if LC_CTYPE="$_loc" locale charmap 2>/dev/null | grep -qx "UTF-8"; then
            export LC_CTYPE="$_loc"; break
        fi
    done
    unset _loc
fi

# --- Color value helpers (defined before arg parsing so --color-* can validate) ---

# Strict hex guard + normalizer: accepts #rgb, #rgba, #rrggbb, #rrggbbaa and
# returns the opaque #rrggbb form (alpha dropped — every downstream consumer
# blends opaque colors, and hex_blend/hex_lerp index fixed 2-char channels).
# Anything else fails, so a junk value is ignored rather than propagated.
norm_hex_color() {
    local v="${1#\#}"
    [[ "$v" =~ ^[0-9A-Fa-f]+$ ]] || return 1
    case "${#v}" in
        3|4) printf '#%s%s%s%s%s%s' "${v:0:1}" "${v:0:1}" "${v:1:1}" "${v:1:1}" "${v:2:1}" "${v:2:1}" ;;
        6|8) printf '#%s' "${v:0:6}" ;;
        *)   return 1 ;;
    esac
}

# A color safe to drop inside a single-quoted Pango attribute. Hex is
# normalized; a bare CSS/Pango color name (e.g. "tomato") is passed through.
# Everything else — anything carrying a quote, angle bracket, or whitespace —
# is rejected, so a --color-* value can never break out of the attribute it is
# interpolated into.
safe_pango_color() {
    local v="$1" hex
    if hex=$(norm_hex_color "$v"); then printf '%s' "$hex"; return 0; fi
    [[ "$v" =~ ^[A-Za-z][A-Za-z0-9]*$ ]] || return 1
    printf '%s' "$v"
}

# --- Parse args ---
FORMAT="{session_pct}% · {session_reset}"
TOOLTIP_FORMAT=""
PACE_TOLERANCE=5
BAR_COLOR_LOW=""
BAR_COLOR_MID=""
BAR_COLOR_HIGH=""
BAR_COLOR_CRITICAL=""
BAR_ICON=""
FORMAT_PACE_COLOR=false
TOOLTIP_PACE_PTS=false
REMAINING=false
JSON_MODE=false
REFRESH=false
NO_COLOR_FLAG=""
FORMAT_SET=false
# Una lista de familias, no una sola: Pango prueba en orden y cae en la
# siguiente si la anterior no está instalada. El paquete de Arch
# ttf-jetbrains-mono-nerd NO provee la familia "…Mono", así que fijar solo
# ese nombre caía en la proporcional del sistema sin decir nada.
TOOLTIP_FONT="JetBrainsMono Nerd Font, JetBrainsMono Nerd Font Mono, monospace"

# Pre-scan for --json BEFORE the parse loop, so argument errors on any earlier
# flag already answer in the structured shape. Never reset afterwards.
for _a in "$@"; do [[ "$_a" == "--json" ]] && JSON_MODE=true && break; done

# Argument-error exit. Fires before the jq availability pre-check, so the
# structured branch needs a jq-less fallback — a FIXED literal (no
# interpolation: without jq there is no safe string encoder).
cli_error() {
    if [[ "$JSON_MODE" == "true" ]]; then
        if command -v jq &>/dev/null; then
            jq -nc --arg m "$1" \
                '{schema_version:2, error:{message:$m}, loading:false, windows:[], credits:null}'
        else
            echo '{"schema_version":2,"error":{"message":"invalid arguments"},"loading":false,"windows":[],"credits":null}'
        fi
    else
        local _m="${1//\\/\\\\}"; _m="${_m//\"/\\\"}"
        printf '{"text":"⚠","tooltip":"%s","class":"critical"}\n' "$_m"
    fi
    exit 0
}

# --help / -h: the reference the user needs is already the header comment of
# this file, so print that rather than a second copy that can drift from it.
# The block runs from the "# Usage:" line to the first line that is not a
# comment, with the leading "# " stripped. Plain text on stdout, exit 0 —
# --json does not apply: a human asked.
show_help() {
    awk '/^# Usage:/ { p = 1 }
         p && !/^#/  { exit }
         p           { sub(/^#( |$)/, ""); print }' "${BASH_SOURCE[0]}"
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h) show_help ;;
        --icon)
            [[ $# -ge 2 ]] || cli_error "--icon requires a value"
            BAR_ICON="$2"; shift 2 ;;
        --format)
            [[ $# -ge 2 ]] || cli_error "--format requires a value"
            FORMAT="$2"; FORMAT_SET=true; shift 2 ;;
        --tooltip-format)
            [[ $# -ge 2 ]] || cli_error "--tooltip-format requires a value"
            TOOLTIP_FORMAT="$2"; shift 2 ;;
        --remaining) REMAINING=true; shift ;;
        --no-color) NO_COLOR_FLAG="all"; shift ;;
        --no-color=*)
            NO_COLOR_FLAG="${1#--no-color=}"
            case "$NO_COLOR_FLAG" in
                all|bar|tooltip) ;;
                *) cli_error "--no-color must be all, bar, or tooltip" ;;
            esac
            shift ;;
        --json) JSON_MODE=true; shift ;;
        --refresh) REFRESH=true; shift ;;
        --tooltip-font) [[ $# -ge 2 ]] || cli_error "--tooltip-font requires a value"
                        TOOLTIP_FONT="$2"; shift 2 ;;
        # Deprecados. --frame dibujaba una caja alrededor del tooltip; se fue.
        # Se siguen aceptando para no romper una config que ya los tenga:
        # --frame no hace nada, --frame-font es un alias de --tooltip-font.
        --frame) shift ;;
        --frame-font) [[ $# -ge 2 ]] || cli_error "--frame-font requires a value"
                      TOOLTIP_FONT="$2"; shift 2 ;;
        --pace-tolerance)
            [[ $# -ge 2 ]] || cli_error "--pace-tolerance requires a value"
            PACE_TOLERANCE="$2"; shift 2 ;;
        --format-pace-color) FORMAT_PACE_COLOR=true; shift ;;
        --tooltip-pace-pts) TOOLTIP_PACE_PTS=true; shift ;;
        --color-low)       [[ $# -ge 2 ]] || cli_error "--color-low requires a value"
                           BAR_COLOR_LOW=$(safe_pango_color "$2") \
                               || cli_error "--color-low must be a hex color (#RGB/#RRGGBB) or a color name"
                           shift 2 ;;
        --color-mid)       [[ $# -ge 2 ]] || cli_error "--color-mid requires a value"
                           BAR_COLOR_MID=$(safe_pango_color "$2") \
                               || cli_error "--color-mid must be a hex color (#RGB/#RRGGBB) or a color name"
                           shift 2 ;;
        --color-high)      [[ $# -ge 2 ]] || cli_error "--color-high requires a value"
                           BAR_COLOR_HIGH=$(safe_pango_color "$2") \
                               || cli_error "--color-high must be a hex color (#RGB/#RRGGBB) or a color name"
                           shift 2 ;;
        --color-critical)  [[ $# -ge 2 ]] || cli_error "--color-critical requires a value"
                           BAR_COLOR_CRITICAL=$(safe_pango_color "$2") \
                               || cli_error "--color-critical must be a hex color (#RGB/#RRGGBB) or a color name"
                           shift 2 ;;
        *) cli_error "Unknown option: $1" ;;
    esac
done
[[ "$PACE_TOLERANCE" =~ ^[0-9]+$ ]] || cli_error "--pace-tolerance must be a non-negative integer"
PACE_TOLERANCE=$((10#$PACE_TOLERANCE))

# Per-surface color switches. NO_COLOR (https://no-color.org) means monochrome
# everywhere when set to a non-empty value; an explicit --no-color=... is the
# more specific instruction and wins over it (so `--no-color=bar` still colors
# the tooltip even with NO_COLOR set).
[[ -z "$NO_COLOR_FLAG" && -n "${NO_COLOR:-}" ]] && NO_COLOR_FLAG="all"
COLOR_BAR=true
COLOR_TOOLTIP=true
case "$NO_COLOR_FLAG" in
    all)     COLOR_BAR=false; COLOR_TOOLTIP=false ;;
    bar)     COLOR_BAR=false ;;
    tooltip) COLOR_TOOLTIP=false ;;
esac
# In remaining mode, default the bar to "what's left" unless the user set their own format.
[[ "$REMAINING" == "true" && "$FORMAT_SET" == "false" ]] && FORMAT="{session_remaining_pct}% · {session_reset}"

CREDS="$HOME/.codex/auth.json"
API_URL="https://chatgpt.com/backend-api/wham/usage"
TOKEN_URL="https://auth.openai.com/oauth/token"
CLIENT_ID="app_EMoamEEZ73f0CkXaXp7hrann" # Codex CLI OAuth client ID
REFRESH_BUFFER=300 # refresh 5 min before expiry
CACHE_DIR="$HOME/.cache/codexbar"
CACHE_TTL=60 # seconds
[[ "$REFRESH" == "true" ]] && CACHE_TTL=0

# Transient (no-HTTP-response) failures retry on a deadline budget, not a fixed
# attempt count. Boot-like starts (no cache, or cache older than
# NET_BOOT_CACHE_AGE) poll up to NET_LONG_BUDGET seconds: at the first Waybar
# exec there is nothing better to show than an empty module, and on re-execs
# the bar keeps the previous output while we wait — waiting beats rendering
# day-old data for a full interval. Mid-session blips keep the quick budget.
# CODEXBAR_TEST_NET_* envs let the test suite shrink the budgets; they are
# not a user interface.
_env_uint() { if [[ "$1" =~ ^[0-9]+$ ]]; then printf '%s' "$1"; else printf '%s' "$2"; fi; }
NET_RETRY_DELAY=$(_env_uint "${CODEXBAR_TEST_NET_RETRY_DELAY:-}" 2)
NET_QUICK_BUDGET=$(_env_uint "${CODEXBAR_TEST_NET_QUICK_BUDGET:-}" 6)
NET_LONG_BUDGET=$(_env_uint "${CODEXBAR_TEST_NET_LONG_BUDGET:-}" 20)
NET_BOOT_CACHE_AGE=600 # cache older than this → boot-like start
NET_WAIT_RECENT=45     # .net_wait younger than this → a sibling already waited

# --- Bounded reads of files this script does not own -------------------------
# The plugin runs INSIDE the long-lived omarchy-shell process, so a read that
# never returns takes the whole shell down with it, not just this module. Every
# path below is written by someone else — the Codex CLI, the Omarchy theme,
# pywal — and any of them can be swapped for a FIFO (the read blocks for ever)
# or for a file that never stops growing (the shell eats the memory).
# Config-shaped inputs get the roomier cap; the credential and the cache are
# small by construction, so a bigger one would only hide corruption.
FILE_MAX_CONFIG=$((256 * 1024))
FILE_MAX_SECRET=$((64 * 1024))
# Responses are a few KiB; 2 MiB is far past anything the API can mean.
HTTP_MAX_BYTES=$((2 * 1024 * 1024))

# A FIFO blocks in open(2), not in read(2), so testing the path and then opening
# it is a race: between the two someone replaces the file. `head` opens without
# O_NONBLOCK and hangs anyway. `dd iflag=nonblock` is the one open in coreutils
# that does not block, and on a regular file it changes nothing. The [[ -f ]]
# stays because it rejects the common case cheaply; iflag=nonblock is what
# closes the race. bs=MAXBYTES count=1 is the bound: one read, never more.
read_bounded() {  # read_bounded PATH MAXBYTES
    [[ -f "$1" ]] || return 1
    LC_ALL=C dd if="$1" iflag=nonblock bs="$2" count=1 status=none 2>/dev/null
}

# `${#var}` counts CHARACTERS under a UTF-8 locale, which under-counts a byte
# budget; wc -c is the byte truth whatever the locale.
byte_len() { LC_ALL=C printf '%s' "$1" | LC_ALL=C wc -c; }

# --- .last_error is written through a fresh file, never opened in place ------
# open(2) for WRITE blocks on a FIFO exactly as the read side does, and this
# path is predictable: a FIFO planted at $CACHE_DIR/.last_error would freeze the
# widget on the error path, which is the path a hostile server can trigger at
# will. Checking the path first would only move the race, so nothing here ever
# opens the destination: mktemp creates a brand-new regular file with O_EXCL,
# and rename(2) replaces whatever sits there without opening it. That closes
# the hang and the TOCTOU in one move.
# Best effort throughout — a read-only cache dir must never abort the widget,
# and a bare `> "$CACHE_DIR/.last_error"` under `set -e` did exactly that: a
# failed open exits the script with no JSON on stdout, breaking the contract.
write_last_error() {  # write_last_error HTTP_CODE MESSAGE
    local tmp
    tmp=$(mktemp "$CACHE_DIR/.last_error.XXXXXX" 2>/dev/null) || return 0
    printf '%s\n%s' "$1" "$2" > "$tmp" 2>/dev/null \
        && mv "$tmp" "$CACHE_DIR/.last_error" 2>/dev/null \
        || rm -f "$tmp" 2>/dev/null || true
    return 0
}

# --- Credentials reach curl through stdin ------------------------------------
# Every argument of a running process is world-readable through
# /proc/PID/cmdline (-r--r--r--), so a token on curl's command line is readable
# by every local user for as long as the request lasts. The environment is
# narrower (/proc/PID/environ is -r--------) but it is still process metadata.
# stdin appears in neither, and unlike a temp config file the secret never
# touches the disk at all: nothing to chmod, nothing to unlink, no residue if
# the process dies in a way no trap covers. The headers go in on `--config -`
# and the refresh body on `--data @-`.
#
# curl parses a config stream one option per LINE, wherever the stream comes
# from, so stdin does NOT close the injection: a value carrying a real newline
# ends the value and turns the rest into fresh options. `url = https://…` plus
# `insecure` makes curl run a SECOND transfer with the header attached — and
# --proto '=https' does not stop that, it only rules out the scheme. Escaping is
# the defence. Quotes and backslashes are escaped; a newline has no meaning in a
# JWT or an account id, so it is dropped rather than encoded.
cfg_escape() {
    local s=${1//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/}
    printf '%s' "${s//$'\r'/}"
}

# --- Theme colors ---
# Blend two hex colors (#RRGGBB) by averaging their RGB components
hex_blend() {
    local c1="${1#\#}" c2="${2#\#}"
    local r1=$((16#${c1:0:2})) g1=$((16#${c1:2:2})) b1=$((16#${c1:4:2}))
    local r2=$((16#${c2:0:2})) g2=$((16#${c2:2:2})) b2=$((16#${c2:4:2}))
    printf '#%02x%02x%02x' $(( (r1+r2)/2 )) $(( (g1+g2)/2 )) $(( (b1+b2)/2 ))
}

# Linear RGB interpolation between two #RRGGBB colors at fraction num/den.
hex_lerp() {
    local c1="${1#\#}" c2="${2#\#}" num=$3 den=$4
    local r1=$((16#${c1:0:2})) g1=$((16#${c1:2:2})) b1=$((16#${c1:4:2}))
    local r2=$((16#${c2:0:2})) g2=$((16#${c2:2:2})) b2=$((16#${c2:4:2}))
    printf '#%02x%02x%02x' \
        $(( r1 + (r2 - r1) * num / den )) \
        $(( g1 + (g2 - g1) * num / den )) \
        $(( b1 + (b2 - b1) * num / den ))
}

load_theme_colors() {
    # Omarchy moved the active theme under the XDG state dir (what the shell's
    # own Color.qml reads); the ~/.config path is the pre-move location, kept
    # as a fallback for older installs. An empty XDG_STATE_HOME means "unset",
    # not "the current directory".
    local state_home="${XDG_STATE_HOME:-}"
    [[ -n "$state_home" ]] || state_home="$HOME/.local/state"
    local theme_file=""
    local candidate
    for candidate in "$state_home/omarchy/current/theme/colors.toml" \
                     "$HOME/.local/state/omarchy/current/theme/colors.toml" \
                     "$HOME/.config/omarchy/current/theme/colors.toml"; do
        [[ -f "$candidate" && -r "$candidate" ]] && { theme_file="$candidate"; break; }
    done
    if [[ -n "$theme_file" ]]; then
        local accent="" foreground="" background="" color1="" color2="" color3=""
        local named_red="" named_green="" named_yellow="" named_orange=""
        # `|| [[ -n "$line" ]]` keeps the last line of a file that doesn't end
        # in a newline — read returns non-zero there and would drop it.
        while IFS= read -r line || [[ -n "$line" ]]; do
            # Skip comments and empty lines
            [[ "$line" =~ ^[[:space:]]*# ]] && continue
            [[ -z "${line// /}" ]] && continue
            # Parse key = "value"
            if [[ "$line" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*\"([^\"]*)\" ]]; then
                local key="${BASH_REMATCH[1]}" val="${BASH_REMATCH[2]}"
                case "$key" in
                    accent)     accent="$val" ;;
                    foreground) foreground="$val" ;;
                    background) background="$val" ;;
                    color1)     color1="$val" ;;
                    color2)     color2="$val" ;;
                    color3)     color3="$val" ;;
                    red)        named_red="$val" ;;
                    green)      named_green="$val" ;;
                    yellow)     named_yellow="$val" ;;
                    orange)     named_orange="$val" ;;
                esac
            fi
        done < <(read_bounded "$theme_file" "$FILE_MAX_CONFIG")
        # Map theme colors to widget colors. EVERY value is validated first: a
        # theme is third-party input, and an unvalidated one both lands inside
        # Pango attributes and feeds base-16 arithmetic below. A bad value is
        # dropped so that slot keeps its built-in default, per key, instead of
        # poisoning the palette or spraying arithmetic errors to stderr.
        local v
        if v=$(norm_hex_color "$accent");     then BLUE="$v"; fi
        if v=$(norm_hex_color "$foreground"); then FG="$v"; fi
        local bg_ok=""
        if v=$(norm_hex_color "$background"); then bg_ok="$v"; fi
        if v=$(norm_hex_color "$color1");     then RED="$v"; ORANGE="$v"; fi
        if v=$(norm_hex_color "$color2");     then GREEN="$v"; fi
        if v=$(norm_hex_color "$color3");     then YELLOW="$v"; fi
        # Named keys win over the colorN aliases: they distinguish red from
        # orange (colorN has to reuse color1 for both), which the severity
        # gauge depends on. Same tolerance the shell's Color.qml applies.
        # Validation happens per key, so an invalid semantic value falls back
        # to the legacy alias rather than suppressing it.
        if v=$(norm_hex_color "$named_red");    then RED="$v"; fi
        if v=$(norm_hex_color "$named_green");  then GREEN="$v"; fi
        if v=$(norm_hex_color "$named_yellow"); then YELLOW="$v"; fi
        if v=$(norm_hex_color "$named_orange"); then ORANGE="$v"; fi
        # DIM = midpoint between foreground and background. Both operands are
        # normalized #rrggbb by now, so the blend arithmetic is always safe.
        if [[ -n "$bg_ok" ]]; then
            DIM=$(hex_blend "$FG" "$bg_ok")
            # BAR_EMPTY = slightly lighter than background (blend bg with dim)
            BAR_EMPTY=$(hex_blend "$bg_ok" "$DIM")
        fi
        MARKER="$FG"
        return 0
    fi
    return 1
}

# pywal fallback — consulted ONLY when no Omarchy theme exists, so it can never
# override an Omarchy theme (or the --color-* flags, which are applied later).
#
# Path: ${XDG_CACHE_HOME:-$HOME/.cache}/wal/colors.json. Original pywal is
# archived, but its cache path is the de-facto standard: the maintained
# pywal16 fork writes the same file and wallust ships a pywal-compat target to
# it, so this one path covers all three.
#
# Missing file, unreadable file, invalid JSON, or junk values all degrade
# silently to the built-in One Dark defaults — never an error, never empty.
load_pywal_colors() {
    local wal_file="${XDG_CACHE_HOME:-$HOME/.cache}/wal/colors.json"
    [[ -f "$wal_file" && -r "$wal_file" ]] || return 1
    command -v jq &>/dev/null || return 1

    # Missing keys emit "-" rather than an empty field: TAB is IFS whitespace,
    # so `read` would collapse runs of empty fields into one delimiter and
    # shift every later value into the wrong variable. "-" is not valid hex,
    # so norm_hex_color rejects it and the built-in default survives.
    local raw
    raw=$(read_bounded "$wal_file" "$FILE_MAX_CONFIG" | jq -r '[
        ((.special.foreground | strings) // "-"),
        ((.special.background | strings) // "-"),
        ((.colors.color1      | strings) // "-"),
        ((.colors.color2      | strings) // "-"),
        ((.colors.color3      | strings) // "-"),
        ((.colors.color4      | strings) // "-"),
        ((.special.cursor     | strings) // "-")
      ] | @tsv' 2>/dev/null) || return 1
    [[ -n "$raw" ]] || return 1

    local w_fg w_bg w_red w_green w_yellow w_blue w_cursor v
    IFS=$'\t' read -r w_fg w_bg w_red w_green w_yellow w_blue w_cursor <<< "$raw"

    # Each key is independent: a missing or non-hex value keeps the built-in
    # default for that slot instead of poisoning the palette.
    local fg_set="" bg_set=""
    if v=$(norm_hex_color "$w_fg");     then FG="$v"; fg_set="$v"; fi
    if v=$(norm_hex_color "$w_bg");     then bg_set="$v"; fi
    if v=$(norm_hex_color "$w_red");    then RED="$v"; fi
    if v=$(norm_hex_color "$w_green");  then GREEN="$v"; fi
    if v=$(norm_hex_color "$w_yellow"); then YELLOW="$v"; fi
    # accent: color4, falling back to the cursor color.
    if v=$(norm_hex_color "$w_blue");   then BLUE="$v"
    elif v=$(norm_hex_color "$w_cursor"); then BLUE="$v"; fi

    # pywal has no orange slot. Synthesize it as the midpoint of yellow and
    # red so the severity gauge keeps four distinct steps — aliasing it to red
    # (the colorN theme compromise) would flatten the 75-90% segment.
    ORANGE=$(hex_blend "$YELLOW" "$RED")

    if [[ -n "$fg_set" && -n "$bg_set" ]]; then
        DIM=$(hex_blend "$fg_set" "$bg_set")
    fi
    MARKER="$FG"
    if [[ -n "$bg_set" ]]; then
        BAR_EMPTY=$(hex_blend "$bg_set" "$DIM")
    fi
    return 0
}

# One Dark defaults — the last step of the color chain.
GREEN="#98c379"
YELLOW="#e5c07b"
ORANGE="#d19a66"
RED="#e06c75"
BLUE="#61afef"
DIM="#5c6370"
FG="#abb2bf"
BAR_EMPTY="#3e4451"
MARKER="$FG"
# Color chain: --color-* flags > Omarchy theme (state dir, then legacy config)
# > pywal cache > One Dark built-ins. pywal is consulted only when no Omarchy
# theme was found, and the flags are applied below, so neither can be
# overridden by a later step.
load_theme_colors || load_pywal_colors || true

# Bar text colors: CLI overrides > theme > One Dark defaults
[[ -n "$BAR_COLOR_LOW" ]]      || BAR_COLOR_LOW="$GREEN"
[[ -n "$BAR_COLOR_MID" ]]      || BAR_COLOR_MID="$YELLOW"
[[ -n "$BAR_COLOR_HIGH" ]]     || BAR_COLOR_HIGH="$ORANGE"
[[ -n "$BAR_COLOR_CRITICAL" ]] || BAR_COLOR_CRITICAL="$RED"

BAR_LEN=20

# Window durations in seconds
SESSION_WINDOW=$(( 5 * 3600 ))      # 5 hours
WEEKLY_WINDOW=$(( 7 * 24 * 3600 ))  # 7 days

# --- Helpers ---

die() {
    if [[ "$JSON_MODE" == "true" ]]; then
        # Structured error shape: same exit-0 philosophy, no markup. Callers
        # pass waybar-tooltip strings, so strip <b> tags and flatten the
        # literal "\n" line breaks they carry. The no-jq fallback escapes the
        # message by hand rather than dropping it: a user without jq still gets
        # told what actually failed.
        local _msg="${1//<b>/}"; _msg="${_msg//<\/b>/}"
        _msg="${_msg//\\n/ }"; _msg="${_msg//$'\n'/ }"
        if command -v jq &>/dev/null; then
            jq -nc --arg m "$_msg" \
                '{schema_version:2, error:{message:$m}, loading:false, windows:[], credits:null}'
        else
            _msg="${_msg//\\/\\\\}"; _msg="${_msg//\"/\\\"}"
            printf '{"schema_version":2,"error":{"message":"%s"},"loading":false,"windows":[],"credits":null}\n' "$_msg"
        fi
        exit 0
    fi
    # Waybar tooltip: turn the callers' literal \n into a real newline so the
    # second line renders as a line break instead of showing "\n" verbatim.
    local _tip="${1//\\n/$'\n'}"
    if command -v jq &>/dev/null; then
        jq -nc --arg t "⚠" --arg tip "$_tip" '{text:$t, tooltip:$tip, class:"critical"}'
    else
        local _m="${_tip//\\/\\\\}"; _m="${_m//\"/\\\"}"; _m="${_m//$'\n'/\\n}"
        printf '{"text":"⚠","tooltip":"%s","class":"critical"}\n' "$_m"
    fi
    exit 0
}

# Soft exit for transient network failures with no usable cache. Emits a neutral
# "Loading…" widget in the low class so Waybar styles it like normal usage and
# doesn't draw attention to a state that will self-resolve on the next dispatch.
loading_network() {
    if [[ "$JSON_MODE" == "true" ]]; then
        # Structured "still waiting" shape — the consumer keeps its last data.
        jq -nc '{schema_version:2, error:null, loading:true, windows:[], credits:null}'
        exit 0
    fi
    jq -nc \
        --arg t "${BAR_ICON:+${BAR_ICON} }Loading…" \
        --arg tip $'Waiting for network — no cached usage yet.\nWill retry shortly.' \
        '{text:$t, tooltip:$tip, class:"low"}'
    exit 0
}

# Relative age for stale messaging. Negative (clock skew) → empty, caller omits it.
rel_age() {
    local s=$1
    if   (( s < 0 ));     then return 0
    elif (( s < 60 ));    then printf 'just now'
    elif (( s < 3600 ));  then printf '%d min ago' $(( s / 60 ))
    elif (( s < 86400 )); then printf '%d h ago' $(( s / 3600 ))
    else printf '%d d ago' $(( s / 86400 ))
    fi
}

# Severity thresholds — single source of truth for waybar classes, bar/tooltip
# colors, and the --json `severity`/`state` fields.
# Severity ramp — the single definition of where each band starts. Everything
# else derives from these: severity_for, the continuous color_for gradient, and
# the `palette.stops` published in --json, which is what keeps the Quickshell
# panel's ramp from drifting when a threshold changes here.
SEVERITY_MID_AT=50
SEVERITY_HIGH_AT=75
SEVERITY_CRITICAL_AT=90

severity_for() {
    local p=$1
    if   (( p >= SEVERITY_CRITICAL_AT )); then printf 'critical'
    elif (( p >= SEVERITY_HIGH_AT ));     then printf 'high'
    elif (( p >= SEVERITY_MID_AT ));      then printf 'mid'
    else printf 'low'
    fi
}

# Continuous severity color: piecewise-linear RGB gradient over used percent,
# passing through the same anchors the old stepped palette used at the
# severity_for thresholds — low at 0%, mid at 50%, high at 75%, critical from
# 90% up. Anchors are the existing color sources (theme-derived, overridable
# with the --color-* flags). Presentation only: the waybar `class` field and
# the --json `state` fields stay discrete via severity_for.
color_for() {
    local p=$1 lo hi num den fb
    (( p < 0 )) && p=0
    (( p > 100 )) && p=100
    if (( p >= SEVERITY_CRITICAL_AT )); then printf '%s' "$BAR_COLOR_CRITICAL"; return; fi
    if   (( p >= SEVERITY_HIGH_AT )); then lo="$BAR_COLOR_HIGH"; hi="$BAR_COLOR_CRITICAL"; num=$(( p - SEVERITY_HIGH_AT )); den=$(( SEVERITY_CRITICAL_AT - SEVERITY_HIGH_AT )); fb="$BAR_COLOR_HIGH"
    elif (( p >= SEVERITY_MID_AT ));  then lo="$BAR_COLOR_MID";  hi="$BAR_COLOR_HIGH";     num=$(( p - SEVERITY_MID_AT ));  den=$(( SEVERITY_HIGH_AT - SEVERITY_MID_AT ));     fb="$BAR_COLOR_MID"
    else                                   lo="$BAR_COLOR_LOW";  hi="$BAR_COLOR_MID";      num=$p;                          den=$SEVERITY_MID_AT;                              fb="$BAR_COLOR_LOW"
    fi
    # Non-hex anchors (e.g. named CSS colors passed via --color-*) can't be
    # interpolated; fall back to the old stepped choice for that segment.
    if [[ "$lo" =~ ^#[0-9A-Fa-f]{6}$ && "$hi" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
        hex_lerp "$lo" "$hi" "$num" "$den"
    else
        printf '%s' "$fb"
    fi
}

pango_escape() {
    sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<< "${1:-}"
}

# Strip color from Pango markup while keeping everything structural: only the
# painting attributes go, so <span font_weight='bold'> stays bold, glyphs, bar
# fill characters, markers and box drawing are untouched, and an attribute-less
# <span> renders exactly like plain text.
#
# Tag-aware on purpose. The bar and tooltip may carry the user's own --format
# markup, so this has to cover attributes we never emit (double-quoted values,
# background=, the underline/overline/strikethrough colors) — while leaving
# body text that merely looks like an attribute alone. Names are matched in
# lowercase because that is the only spelling Pango itself honors.
decolor() {
    awk '''
    BEGIN {
        q = sprintf("%c", 39)   # single quote, built here to dodge shell quoting
        names = "foreground|fgcolor|color|background|bgcolor|underline_color|overline_color|strikethrough_color"
        re = "[ \t]+(" names ")[ \t]*=[ \t]*(\"[^\"]*\"|" q "[^" q "]*" q "|[^ \t>]+)"
    }
    {
        out = ""; rest = $0
        while ((i = index(rest, "<")) > 0) {
            out = out substr(rest, 1, i - 1)
            after = substr(rest, i + 1)
            j = index(after, ">")
            if (j == 0) { out = out substr(rest, i); rest = ""; break }
            tag = substr(after, 1, j - 1)
            rest = substr(after, j + 1)
            gsub(re, "", tag)
            out = out "<" tag ">"
        }
        print out rest
    }'''
}

format_plan_label() {
    local raw="${1:-unknown}" label
    case "$raw" in
        prolite|pro_lite|pro-lite) printf 'Pro Lite' ;;
        self_serve_business_usage_based) printf 'Business Usage Based' ;;
        enterprise_cbp_usage_based) printf 'Enterprise Usage Based' ;;
        *)
            label="${raw//[_-]/ }"
            printf '%s' "${label^}"
            ;;
    esac
}

is_approx_window() {
    local seconds=$1 expected=$2
    (( seconds >= expected * 95 / 100 && seconds <= expected * 105 / 100 ))
}

window_label_for_seconds() {
    local seconds=${1:-0} is_secondary=${2:-0}
    local hour=$(( 60 * 60 ))
    local day=$(( 24 * hour ))
    if is_approx_window "$seconds" "$(( 5 * hour ))"; then
        printf '5h'
    elif is_approx_window "$seconds" "$day"; then
        printf 'daily'
    elif is_approx_window "$seconds" "$(( 7 * day ))"; then
        printf 'weekly'
    elif is_approx_window "$seconds" "$(( 30 * day ))"; then
        printf 'monthly'
    elif is_approx_window "$seconds" "$(( 365 * day ))"; then
        printf 'annual'
    elif (( is_secondary )); then
        printf 'secondary usage'
    else
        printf 'usage'
    fi
}

# Display label for a rate-limit window, derived from its real duration (the
# API no longer guarantees primary=5h/secondary=weekly). The 5h window keeps
# its historical "Session" name — EVERY 5h window, including the ones hanging
# off an additional meter: the same duration answering to two different names
# in one tooltip is the kind of thing a reader has to stop and decode.
main_window_label() {  # <seconds> <is_secondary>
    local label
    label=$(window_label_for_seconds "$1" "$2")
    [[ "$label" == "5h" ]] && label="session"
    printf '%s' "${label^}"
}

main_window_icon() {  # <label from main_window_label>
    case "$1" in
        Weekly|Monthly|Annual) printf '󰃰' ;;
        *) printf '󰔟' ;;
    esac
}

remaining_pct_for() {
    local p=${1:-0}
    (( p < 0 )) && p=0
    (( p > 100 )) && p=100
    printf '%s' "$(( 100 - p ))"
}

# Percentage to DISPLAY for a window under the current framing.
display_pct() {  # <used_pct>
    if [[ "$REMAINING" == "true" ]]; then remaining_pct_for "$1"; else printf '%s' "$1"; fi
}

# Progress bar to DISPLAY for a window under the current framing.
# Usage: display_bar <used_pct> <elapsed_pct> [with_marker]
# Usage framing fills along the shared per-cell ramp; remaining framing is a
# drain bar (the ramp semantics would invert), so it keeps a single color —
# the continuous severity tint of the window's used percent.
display_bar() {
    local used=$1 elapsed=$2 with_marker=${3:-} color
    if [[ "$REMAINING" == "true" ]]; then
        color=$(color_for "$used")
        local rem; rem=$(remaining_pct_for "$used")
        if [[ -n "$with_marker" ]]; then
            make_bar "$rem" "$color" "$(( 100 - elapsed ))" "$MARKER"
        else
            make_bar "$rem" "$color"
        fi
    else
        if [[ -n "$with_marker" ]]; then
            make_bar "$used" gradient "$elapsed" "$MARKER"
        else
            make_bar "$used" gradient
        fi
    fi
}

# Pacing severity based on signed pacing delta, centered around zero:
#   <= -11  under   (well under pace, plenty of room)     → green
#   -10..0  on_pace (slightly under or exactly on pace)   → yellow
#   1..+9   ahead   (slightly ahead, watch it)            → orange
#   >= +10  hot     (burning fast)                        → red
# Same single-source rule as severity_for: --format-pace-color and the
# --json per-window pace "state" field both derive from this.
pace_severity_for() {
    local delta=${1:-0}
    if   (( delta >= 10 ));  then printf 'hot'
    elif (( delta > 0 ));    then printf 'ahead'
    elif (( delta >= -10 )); then printf 'on_pace'
    else printf 'under'
    fi
}

pace_color_for() {
    case "$(pace_severity_for "${1:-0}")" in
        hot)     printf '%s' "$RED"     ;;
        ahead)   printf '%s' "$ORANGE"  ;;
        on_pace) printf '%s' "$YELLOW"  ;;
        *)       printf '%s' "$GREEN"   ;;
    esac
}

# Render <count> filled bar cells starting at 0-based cell <start>.
# A fixed color emits one span; the literal color "gradient" emits one span
# per cell, each colored by the positional percent at that cell's center —
# a VU-meter ramp every bar shares and fills along.
_bar_fill() {  # <start_cell> <count> <color|gradient>
    local s=$1 n=$2 color=$3 i c f
    (( n <= 0 )) && return 0
    if [[ "$color" != "gradient" ]]; then
        printf -v f '%*s' "$n" ''
        printf "<span foreground='%s'>%s</span>" "$color" "${f// /█}"
        return 0
    fi
    for (( i = s; i < s + n; i++ )); do
        c=$(color_for $(( (i * 100 + 50) / BAR_LEN )))
        printf "<span foreground='%s'>█</span>" "$c"
    done
}

# Build a progress bar with optional elapsed marker.
# Usage: make_bar <pct> <color|gradient> [marker_pct] [marker_color]
make_bar() {
    local p=$1 color=$2 marker_pos=${3:--1} marker_color=${4:-}
    local filled=$(( p * BAR_LEN / 100 ))
    (( filled > BAR_LEN )) && filled=$BAR_LEN
    (( filled < 0 )) && filled=0

    local e=""
    if (( marker_pos < 0 )); then
        _bar_fill 0 "$filled" "$color"
        printf -v e '%*s' "$(( BAR_LEN - filled ))" ''
        printf "<span foreground='%s'>%s</span>" "$BAR_EMPTY" "${e// /░}"
        return
    fi

    local m=$(( marker_pos * BAR_LEN / 100 ))
    (( m > BAR_LEN - 1 )) && m=$(( BAR_LEN - 1 ))
    local pre_f=$(( filled < m ? filled : m ))
    local post_f=$(( filled > m + 1 ? filled - m - 1 : 0 ))

    _bar_fill 0 "$pre_f" "$color"
    printf -v e '%*s' "$(( m - pre_f ))" ''
    printf "<span foreground='%s'>%s</span>" "$BAR_EMPTY" "${e// /░}"
    printf "<span foreground='%s'>┃</span>" "$marker_color"
    _bar_fill $(( m + 1 )) "$post_f" "$color"
    printf -v e '%*s' "$(( BAR_LEN - m - 1 - post_f ))" ''
    printf "<span foreground='%s'>%s</span>" "$BAR_EMPTY" "${e// /░}"
}

# Convert unix timestamp to countdown string
countdown() {
    local ts=$1
    [[ -z "$ts" || "$ts" == "0" || "$ts" == "null" ]] && { echo "—"; return; }
    local now diff d h m
    now=$(date +%s)
    diff=$(( ts - now ))
    (( diff <= 0 )) && { echo "now"; return; }
    d=$(( diff / 86400 ))
    h=$(( diff % 86400 / 3600 ))
    m=$(( diff % 3600 / 60 ))
    if (( d > 0 )); then
        echo "${d}d ${h}h"
    else
        printf '%dh %02dm' "$h" "$m"
    fi
}

# Calculate time elapsed % and pacing for a usage window.
# Uses point-based delta (actual - expected) for the icon and delta values.
# Also computes the original ratio-based label for backward-compatible placeholders.
#
# Args: usage_pct reset_at_unix window_duration_seconds
# Output fields (6 logical, 8 space-separated tokens due to multi-word labels):
#   elapsed_pct pace_icon pace_indicator pace_delta pace_pct_label pace_pts_label
calc_pacing() {
    local usage_pct=$1 reset_at=$2 window_s=$3
    local elapsed_pct=0 pace_icon="→" pace_indicator="→" pace_delta="0"
    local pace_pct_label="on pace" pace_pts_label="on pace"

    if [[ -n "$reset_at" && "$reset_at" != "0" && "$reset_at" != "null" ]] && (( window_s > 0 )); then
        local now_epoch secs_left
        now_epoch=$(date +%s)
        secs_left=$(( reset_at - now_epoch ))
        elapsed_pct=$(( (window_s - secs_left) * 100 / window_s ))
        (( elapsed_pct < 0 )) && elapsed_pct=0
        (( elapsed_pct > 100 )) && elapsed_pct=100

        # Point-based delta for indicator, delta, and pts label
        local delta=$(( usage_pct - elapsed_pct ))
        pace_delta="$delta"
        if (( delta > 0 )); then
            pace_indicator="↑"
            pace_pts_label="${delta}pts ahead"
        elif (( delta < 0 )); then
            pace_indicator="↓"
            pace_pts_label="$(( -delta ))pts under"
        fi

        # Ratio-based icon and label for backward-compatible {*_pace} and {*_pace_pct}
        if (( elapsed_pct > 0 )); then
            local pacing_x100=$(( usage_pct * 100 / elapsed_pct ))
            if (( pacing_x100 > 100 + PACE_TOLERANCE )); then
                local dev=$(( pacing_x100 - 100 ))
                (( dev > 999 )) && dev=999
                pace_icon="↑"
                pace_pct_label="${dev}% ahead"
            elif (( pacing_x100 < 100 - PACE_TOLERANCE )); then
                local dev=$(( 100 - pacing_x100 ))
                (( dev > 999 )) && dev=999
                pace_icon="↓"
                pace_pct_label="${dev}% under"
            fi
        fi
    fi

    echo "${elapsed_pct} ${pace_icon} ${pace_indicator} ${pace_delta} ${pace_pct_label} ${pace_pts_label}"
}

# Decode JWT payload (base64url → JSON)
jwt_decode() {
    local token=$1 payload pad decoded
    payload=$(echo "$token" | cut -d. -f2)
    pad=$(( 4 - ${#payload} % 4 ))
    (( pad < 4 )) && payload+=$(printf '%*s' "$pad" '' | tr ' ' '=')
    payload="${payload//-/+}"
    payload="${payload//_//}"
    decoded=$(echo "$payload" | base64 -d 2>/dev/null || true)
    # Always emit exactly one JSON OBJECT ("{}" for any malformed, empty, or
    # non-object payload) so callers piping into jq never hit a parse OR index error.
    printf '%s' "$decoded" | jq -c -s 'if length == 1 and (.[0] | type == "object") then .[0] else {} end' 2>/dev/null || printf '{}'
}

jwt_exp() { jwt_decode "$1" | jq -r '((.exp | numbers) // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end'; }

# --- Pre-checks ---
# dd belongs here: read_bounded uses it for the only open(2) in coreutils that
# does not block on a FIFO, so a missing dd is a missing guard, not a missing
# convenience.
for cmd in curl jq date base64 dd; do
    command -v "$cmd" &>/dev/null || die "Missing dependency: $cmd"
done
[[ -f "$CREDS" ]] || die "No credentials.\nRun <b>codex login</b> to log in."

# --- Cache / lock setup ---
mkdir -p "$CACHE_DIR" 2>/dev/null || die "Cannot create cache dir.\n$CACHE_DIR is not writable."
cache_file="$CACHE_DIR/usage.json"
stale_marker="$CACHE_DIR/.stale"
net_wait_marker="$CACHE_DIR/.net_wait"
_lockfile="$CACHE_DIR/.fetch.lock"

_fetch_usage() {
    if [[ -f "$cache_file" ]] && (( cache_age < CACHE_TTL )); then
        usage=$(read_bounded "$cache_file" "$FILE_MAX_SECRET") || usage=""
        return
    fi

    if [[ "$auth_ok" == "false" ]]; then
        if [[ "$refresh_failure_kind" == "transient" ]]; then
            # Network blip — stay quiet. Reuse recent cache with an in-memory
            # stale flag, or show neutral "Loading…" if no usable cache exists.
            # No disk markers, no desktop notification.
            if [[ -f "$cache_file" ]] && (( cache_age <= WEEKLY_WINDOW )); then
                usage=$(read_bounded "$cache_file" "$FILE_MAX_SECRET") || usage=""
                transient_stale=true
                return
            fi
            loading_network
        fi
        # Hard refresh failure — preserve actionable signal (.last_error was
        # written by the refresh path so the tooltip can explain the failure).
        if [[ -f "$cache_file" ]] && (( cache_age <= WEEKLY_WINDOW )); then
            usage=$(read_bounded "$cache_file" "$FILE_MAX_SECRET") || usage=""
            if [[ ! -f "$stale_marker" ]]; then
                touch "$stale_marker"
                command -v notify-send &>/dev/null && \
                    notify-send -u normal -i dialog-warning \
                        "Codex Usage" "Token refresh failed. Check connection or run <b>codex login</b>." 2>/dev/null || true
            fi
        else
            die "Token refresh failed.\nCheck connection or run <b>codex login</b>."
        fi
        return
    fi

    # Transient failures (no HTTP response: DHCP/DNS still settling at boot,
    # brief blip) are retried until the shared deadline — one missed dispatch
    # otherwise means stale data for a full Waybar interval.
    # The bearer token AND the account id identify the user, so both travel on
    # stdin rather than argv. --proto pins https so no crafted URL can carry the
    # token in cleartext, and --max-filesize caps what a hostile or broken
    # server can make this shell hold. The config is rebuilt on every retry
    # because each curl consumes its own stdin.
    _fetch_cfg="header = \"Authorization: Bearer $(cfg_escape "$access_token")\""
    if [[ -n "$account_id" ]]; then
        _fetch_cfg+=$'\n'"header = \"chatgpt-account-id: $(cfg_escape "$account_id")\""
    fi
    _fetch_args=(-s --max-time 10 --max-filesize "$HTTP_MAX_BYTES" --proto '=https'
                 --config - -w $'\n%{http_code}' "$API_URL")
    while :; do
        # -q FIRST, before anything else: curl reads ~/.curlrc BEFORE the
        # --config stream we hand it, so without -q the whole escape above is
        # bypassable — the same attacker who could plant a FIFO in the cache dir
        # writes `url = …` or `insecure` there and the token leaves with them.
        # -q placed after another option is already too late (measured).
        _resp_body=$(printf '%s\n' "$_fetch_cfg" | curl -q "${_fetch_args[@]}") || true
        _http_code="${_resp_body##*$'\n'}"
        _resp_body="${_resp_body%$'\n'"$_http_code"}"
        # Normalize bogus codes (e.g. raw body without curl write-out suffix) to 000.
        [[ "$_http_code" =~ ^[0-9]{3}$ ]] || _http_code="000"
        if [[ "$_http_code" != "000" ]]; then break; fi
        if (( SECONDS >= net_deadline )); then break; fi
        sleep "$NET_RETRY_DELAY"
    done
    # Belt for --max-filesize: this curl refuses a declared Content-Length
    # overrun before a byte moves, but aborts a CHUNKED one only AFTER writing
    # the cap — and the -w suffix still arrives, so a truncated body would read
    # as a healthy 200. Reaching the cap is never a real answer; drop it and
    # fall through to the stale-cache path.
    if (( $(byte_len "$_resp_body") >= HTTP_MAX_BYTES )); then _resp_body=""; fi

    if [[ "$_http_code" == "200" ]] && [[ -n "$_resp_body" ]] && jq -e '.rate_limit' <<< "$_resp_body" &>/dev/null; then
        usage="$_resp_body"
        _ctmp=$(mktemp "$CACHE_DIR/.usage.XXXXXX")
        printf '%s' "$usage" > "$_ctmp" && mv "$_ctmp" "$cache_file"
        rm -f "$stale_marker" "$net_wait_marker" "$CACHE_DIR/.last_error"
    elif [[ "$_http_code" == "000" ]]; then
        # No HTTP response after the retry budget — network still settling or
        # offline. Mark the episode so sibling instances skip their own long
        # wait, then reuse recent cache with an in-memory stale flag (no .stale
        # on disk), or show neutral "Loading…".
        if [[ "$net_long" == "true" ]]; then touch "$net_wait_marker" 2>/dev/null || true; fi
        if [[ -f "$cache_file" ]] && (( cache_age <= WEEKLY_WINDOW )); then
            usage=$(read_bounded "$cache_file" "$FILE_MAX_SECRET") || usage=""
            transient_stale=true
        else
            loading_network
        fi
    elif [[ -f "$cache_file" ]]; then
        usage=$(read_bounded "$cache_file" "$FILE_MAX_SECRET") || usage=""
        touch "$stale_marker"
        if [[ "$_http_code" =~ ^[45][0-9]{2}$ ]]; then
            _err_msg=$(jq -r '.error.message // empty' <<< "$_resp_body" 2>/dev/null) || true
            write_last_error "$_http_code" "$_err_msg"
        fi
    else
        die "API request failed.\nCheck your connection."
    fi
}

# --- Acquire lock for the state-changing window (credential read + refresh + fetch) ---
# Multi-monitor: peer instances may rotate the refresh_token between a pre-lock
# read and our refresh attempt (the provider rotates refresh tokens); reading
# auth.json only under the lock prevents a stale-token refresh from hard-failing
# with a spurious "run codex login" while credentials are actually fine.
#
# open(2) for WRITE blocks on a FIFO exactly as the read side does — it waits
# for a reader that never comes — and this redirect is the first thing every run
# does, so a FIFO planted here freezes omarchy-shell before anything is drawn.
# The path is predictable, so demand a regular file (or nothing yet) first.
#
# That check alone is a race: `9>` still opens whatever the path names by the
# time it runs. `<>` is the fix, not a style choice. Linux defines opening a
# FIFO O_RDWR as non-blocking (POSIX leaves it undefined, and this script is
# Linux-only), so the open returns whatever an attacker swaps in, and flock
# works the same on the descriptor. `<>` also does not truncate, which the lock
# file — empty by construction — never needed. Residue: a character device in
# that spot could still block on open, but planting one needs CAP_MKNOD, which
# is outside what the same-user attacker of this threat model has.
[[ ! -e "$_lockfile" || -f "$_lockfile" ]] || die "Cache lock is not a regular file.\n$_lockfile"
{ exec 9<>"$_lockfile"; } 2>/dev/null || die "Cannot open cache lock.\n$_lockfile is not writable."
# Generous wait: a boot-like sibling may hold the lock for the long budget plus
# in-flight curls (worst ≈ NET_LONG_BUDGET + 25s refresh + 10s fetch ≈ 57s);
# rendering late beats dying with a visible "Cache lock timeout".
flock -w 90 9 || die "Cache lock timeout"

# --- Transient retry budget (shared by token refresh and usage fetch) ---
now_s=$(date +%s)
cache_age=-1
[[ -f "$cache_file" ]] && cache_age=$(( now_s - $(date -r "$cache_file" +%s) ))
# Missing cache or future mtime (clock skew) → boot-like, never "fresh".
if (( cache_age < 0 )); then cache_age=$(( NET_BOOT_CACHE_AGE + 1 )); fi
net_budget=$NET_QUICK_BUDGET
net_long=false
if (( cache_age > NET_BOOT_CACHE_AGE )); then
    net_budget=$NET_LONG_BUDGET
    net_long=true
    if [[ -f "$net_wait_marker" ]]; then
        _nw_age=$(( now_s - $(date -r "$net_wait_marker" +%s) ))
        # A sibling already burned the long budget this episode — single
        # attempt, no sleeps. Future mtimes (clock skew) don't count.
        if (( _nw_age >= 0 && _nw_age <= NET_WAIT_RECENT )); then
            net_budget=0
            net_long=false
        fi
    fi
fi
net_deadline=$(( SECONDS + net_budget ))

# --- Read credentials (under the lock) ---
[[ -f "$CREDS" ]] || die "No credentials.\nRun <b>codex login</b> to log in."
creds=$(read_bounded "$CREDS" "$FILE_MAX_SECRET") || die "Unreadable credentials.\nRun <b>codex login</b> to log in."
jq -e . <<< "$creds" &>/dev/null || die "Invalid credentials file.\nRun <b>codex login</b> to log in."
access_token=$(jq -r '.tokens.access_token // empty' <<< "$creds")
refresh_token=$(jq -r '.tokens.refresh_token // empty' <<< "$creds")
account_id=$(jq -r '.tokens.account_id // empty' <<< "$creds")

[[ -n "$access_token" ]] || die "No token.\nRun <b>codex login</b> to log in."

# Extract plan type from id_token JWT claims
id_token_raw=$(jq -r '.tokens.id_token // empty' <<< "$creds")
plan_type="unknown"
if [[ -n "$id_token_raw" ]]; then
    _pt=$(jwt_decode "$id_token_raw" | jq -r '(."https://api.openai.com/auth".chatgpt_plan_type? // empty)')
    [[ -n "$_pt" ]] && plan_type="$_pt"
fi

# --- Token refresh if needed (under the lock) ---
expires_s=$(jwt_exp "$access_token")
auth_ok=true
refresh_failure_kind=""
transient_stale=false

# The write-back temp is staged BEFORE the POST, and beside its target. Both
# halves matter. Same-directory: a bare mktemp lands in /tmp, which is a tmpfs
# here — a different filesystem from ~/.codex — where `mv` degrades from
# rename(2) to copy+unlink and an interruption can leave a torn auth.json.
# Before the POST: a 200 from the token endpoint rotates the refresh token,
# so a refresh whose result cannot be persisted must not run at all —
# skipping it leaves the stored tokens untouched for the next run to retry.
cred_tmp=""
if (( expires_s < now_s + REFRESH_BUFFER )); then
    cred_tmp=$(mktemp "${CREDS%/*}/.auth.XXXXXX" 2>/dev/null) || cred_tmp=""
    if [[ -z "$cred_tmp" ]]; then
        auth_ok=false
        refresh_failure_kind="transient"
    fi
fi

if [[ -n "$cred_tmp" ]]; then
    # Synchronous refresh — 25s timeout covers cold boot when DHCP is still settling.
    # Transient failures (no HTTP response) are retried until the shared deadline —
    # same policy as the usage fetch — so a cold-boot race doesn't cost a full interval.
    # The refresh token must miss jq's argv as well: /proc/PID/cmdline is
    # world-readable, /proc/PID/environ is owner-only.
    refresh_body=$(CODEXBAR_RT="$refresh_token" jq -nc --arg ci "$CLIENT_ID" \
                     '{client_id:$ci, grant_type:"refresh_token", refresh_token:env.CODEXBAR_RT, scope:"openid profile email"}')
    # That body IS the credential, so it goes in on stdin. --data @- takes it
    # verbatim: no config grammar, so no line to inject into either. Content-Type
    # is not a secret and stays on the command line.
    _refresh_args=(-s --max-time 25 --max-filesize "$HTTP_MAX_BYTES" --proto '=https'
                   -w '\n%{http_code}' -X POST "$TOKEN_URL"
                   -H "Content-Type: application/json" --data @-)
    while :; do
        # -q first for the same reason as the usage fetch: a hostile ~/.curlrc
        # would otherwise redirect the refresh token to an attacker's URL.
        refresh_raw=$(printf '%s' "$refresh_body" | curl -q "${_refresh_args[@]}") || true
        refresh_code="${refresh_raw##*$'\n'}"
        resp="${refresh_raw%$'\n'"$refresh_code"}"
        # Normalize bogus codes (e.g. raw body without curl write-out suffix) to 000.
        [[ "$refresh_code" =~ ^[0-9]{3}$ ]] || refresh_code="000"
        if [[ "$refresh_code" != "000" ]]; then break; fi
        if (( SECONDS >= net_deadline )); then break; fi
        sleep "$NET_RETRY_DELAY"
    done
    # Same belt as the usage fetch — an oversized refresh answer is not an answer.
    if (( $(byte_len "$resp") >= HTTP_MAX_BYTES )); then resp=""; fi

    if [[ "$refresh_code" == "200" ]] && [[ -n "$resp" ]] && jq -e '.access_token' <<< "$resp" &>/dev/null; then
        new_at=$(jq -r '.access_token // empty' <<< "$resp")
        new_rt=$(jq -r '.refresh_token // empty' <<< "$resp")
        new_idt=$(jq -r '.id_token // empty' <<< "$resp")
        now_iso=$(date -u +%Y-%m-%dT%H:%M:%S.000000000Z)

        [[ -n "$new_at" ]] && access_token="$new_at"

        # Re-read before replacing: the flock serializes codexbar instances,
        # but NOT the codex CLI, and the POST above takes seconds. If the file
        # changed under us (or the re-read comes back truncated), the CLI
        # refreshed on its own — its tokens are the fresher ones, so ours are
        # dropped instead of overwriting its write. Best-effort mitigation,
        # not a CAS: the check-then-rename window is milliseconds.
        current=$(read_bounded "$CREDS" "$FILE_MAX_SECRET") || current=""
        if [[ "$current" == "$creds" ]] && (( $(byte_len "$current") < FILE_MAX_SECRET )); then
            # Same argv rule for the three new token values. The jq input is
            # the bounded copy already validated under this lock, not a fresh
            # read of $CREDS: that bounds the read and shuts the window in
            # which the file could be swapped for a FIFO between the check
            # and the rewrite. A failed write leaves the old file alone — the
            # in-memory token still serves this run, and exiting non-zero
            # would break the widget.
            CODEXBAR_AT="${new_at:-$access_token}" \
            CODEXBAR_RT="${new_rt:-$refresh_token}" \
            CODEXBAR_IDT="${new_idt:-$id_token_raw}" \
            jq --arg lr "$now_iso" \
               '.tokens.access_token=env.CODEXBAR_AT | .tokens.refresh_token=env.CODEXBAR_RT | .tokens.id_token=env.CODEXBAR_IDT | .last_refresh=$lr' \
               <<< "$creds" > "$cred_tmp" && mv "$cred_tmp" "$CREDS" \
               || rm -f "$cred_tmp" 2>/dev/null || true
        else
            rm -f "$cred_tmp" 2>/dev/null || true   # the CLI wrote mid-refresh: keep its write
        fi
        rm -f "$CACHE_DIR/.last_error" 2>/dev/null || true
    else
        auth_ok=false
        rm -f "$cred_tmp" 2>/dev/null || true
        if [[ "$refresh_code" == "000" ]]; then
            # No HTTP response reached us — DHCP/DNS settling at boot, offline,
            # or actual timeout. Mark the episode so sibling instances skip
            # their own long wait; nothing else persists.
            refresh_failure_kind="transient"
            if [[ "$net_long" == "true" ]]; then touch "$net_wait_marker" 2>/dev/null || true; fi
        else
            refresh_failure_kind="hard"
            # Persist the failure so the tooltip can say WHY data is stale.
            # platform returns OAuth-style {error,error_description}; fall back
            # to Anthropic-style {error:{message}} or bare {error:"<str>"}.
            refresh_err=""
            if [[ "$refresh_code" =~ ^[45][0-9]{2}$ ]]; then
                refresh_err=$(jq -r '
                    if (.error_description | type) == "string" then .error_description
                    elif (.error | type) == "object" and (.error | has("message")) and (.error.message | type) == "string" then .error.message
                    elif (.error | type) == "string" then .error
                    else "" end' <<< "$resp" 2>/dev/null) || true
                [[ -z "$refresh_err" ]] && refresh_err="Refresh failed"
            else
                refresh_err="Invalid refresh response"
            fi
            write_last_error "$refresh_code" "$refresh_err"
        fi
    fi
fi

_fetch_usage
exec 9>&-

# A corrupt/partial/multi-document cache could make the per-field reads emit
# garbage or parse-error; require exactly one valid JSON document up front.
jq -e -s 'length == 1' <<< "$usage" &>/dev/null || die "Invalid usage data.\nWill refresh next cycle."

# --- Parse windows ---
session_pct=$(jq -r 'try (((.rate_limit.primary_window.used_percent | numbers) // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end) catch 0' <<< "$usage")
session_reset_at=$(jq -r 'try (((.rate_limit.primary_window.reset_at | numbers) // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end) catch 0' <<< "$usage")
session_window_s=$(jq -r 'try (((.rate_limit.primary_window.limit_window_seconds | numbers) // 18000) | floor | if (. > 1e12 or . < 0) then 0 else . end) catch 18000' <<< "$usage")
weekly_pct=$(jq -r 'try (((.rate_limit.secondary_window.used_percent | numbers) // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end) catch 0' <<< "$usage")
weekly_reset_at=$(jq -r 'try (((.rate_limit.secondary_window.reset_at | numbers) // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end) catch 0' <<< "$usage")
weekly_window_s=$(jq -r 'try (((.rate_limit.secondary_window.limit_window_seconds | numbers) // 604800) | floor | if (. > 1e12 or . < 0) then 0 else . end) catch 604800' <<< "$usage")
(( session_window_s > 0 )) || session_window_s=$SESSION_WINDOW
(( weekly_window_s > 0 )) || weekly_window_s=$WEEKLY_WINDOW
has_secondary=$(jq 'try ((.rate_limit.secondary_window | type) == "object") catch false' <<< "$usage")
# Newer API responses expose a single weekly limit: primary_window carries it
# (limit_window_seconds ≈ 7d) and secondary_window is null. Mirror the primary
# into the weekly fields so {weekly_*} placeholders keep reporting real usage
# instead of a misleading 0%.
if [[ "$has_secondary" == "false" ]] && is_approx_window "$session_window_s" "$WEEKLY_WINDOW"; then
    weekly_pct=$session_pct
    weekly_reset_at=$session_reset_at
    weekly_window_s=$session_window_s
fi
session_remaining_pct=$(remaining_pct_for "$session_pct")
weekly_remaining_pct=$(remaining_pct_for "$weekly_pct")

# Code review
has_review=$(jq 'try (.code_review_rate_limit != null and .code_review_rate_limit.primary_window != null) catch false' <<< "$usage")
review_pct=0
review_reset_at=0
if [[ "$has_review" == "true" ]]; then
    review_pct=$(jq -r 'try (((.code_review_rate_limit.primary_window.used_percent | numbers) // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end) catch 0' <<< "$usage")
    review_reset_at=$(jq -r 'try (((.code_review_rate_limit.primary_window.reset_at | numbers) // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end) catch 0' <<< "$usage")
    review_window_s=$(jq -r 'try (((.code_review_rate_limit.primary_window.limit_window_seconds | numbers) // 604800) | floor | if (. > 1e12 or . < 0) then 0 else . end) catch 604800' <<< "$usage")
    (( review_window_s > 0 )) || review_window_s=$WEEKLY_WINDOW
fi
review_remaining_pct=$(remaining_pct_for "$review_pct")

# Additional Codex model-specific meters. Codex itself maps these as separate
# rate-limit snapshots; keep them available for tooltip and severity decisions.
additional_limits_tsv=$(jq -r '
  .additional_rate_limits[]?
  | select(type == "object")
  | [
      ((.limit_name | strings | select(. != "")) // (.metered_feature | strings | select(. != "")) // "Additional"),
      (((((try .rate_limit.primary_window.used_percent catch null) | numbers) // 0) | floor) | if (. > 1e12 or . < 0) then 0 else . end),
      (((((try .rate_limit.primary_window.reset_at catch null) | numbers) // 0) | floor) | if (. > 1e12 or . < 0) then 0 else . end),
      (((((try .rate_limit.primary_window.limit_window_seconds catch null) | numbers) // 0) | floor) | if (. > 1e12 or . < 0) then 0 else . end),
      (((((try .rate_limit.secondary_window.used_percent catch null) | numbers) // 0) | floor) | if (. > 1e12 or . < 0) then 0 else . end),
      (((((try .rate_limit.secondary_window.reset_at catch null) | numbers) // 0) | floor) | if (. > 1e12 or . < 0) then 0 else . end),
      (((((try .rate_limit.secondary_window.limit_window_seconds catch null) | numbers) // 0) | floor) | if (. > 1e12 or . < 0) then 0 else . end)
    ]
  | @tsv
' <<< "$usage")
# Severity must track what the tooltip actually renders: only count a window's
# usage when that window is displayable (limit_window_seconds > 0). Otherwise an
# additional meter could push the widget to a worse class with nothing shown.
additional_max_pct=$(jq -r '
  ([.additional_rate_limits[]?
    | select(type == "object")
    | (if (((((try .rate_limit.primary_window.limit_window_seconds catch null) | numbers) // 0)) | floor | if (. > 1e12 or . < 0) then 0 else . end) > 0
         then ((((try .rate_limit.primary_window.used_percent catch null) | numbers) // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end) else empty end),
      (if (((((try .rate_limit.secondary_window.limit_window_seconds catch null) | numbers) // 0)) | floor | if (. > 1e12 or . < 0) then 0 else . end) > 0
         then ((((try .rate_limit.secondary_window.used_percent catch null) | numbers) // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end) else empty end)
  ] | max // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end
' <<< "$usage")

# Credits
credits_balance=$(jq -r 'try (.credits.balance // "0") catch "0"' <<< "$usage")
has_credits=$(jq -r 'try (.credits.has_credits // false) catch false' <<< "$usage")
credits_unlimited=$(jq -r 'try (.credits.unlimited // false) catch false' <<< "$usage")
credits_local_lo=$(jq -r 'try (((.credits.approx_local_messages[0] | numbers) // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end) catch 0' <<< "$usage")
credits_local_hi=$(jq -r 'try (((.credits.approx_local_messages[1] | numbers) // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end) catch 0' <<< "$usage")
credits_cloud_lo=$(jq -r 'try (((.credits.approx_cloud_messages[0] | numbers) // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end) catch 0' <<< "$usage")
credits_cloud_hi=$(jq -r 'try (((.credits.approx_cloud_messages[1] | numbers) // 0) | floor | if (. > 1e12 or . < 0) then 0 else . end) catch 0' <<< "$usage")

# Format credits local/cloud as range strings
if (( credits_local_lo == credits_local_hi )); then
    credits_local="${credits_local_lo}"
else
    credits_local="${credits_local_lo}–${credits_local_hi}"
fi
if (( credits_cloud_lo == credits_cloud_hi )); then
    credits_cloud="${credits_cloud_lo}"
else
    credits_cloud="${credits_cloud_lo}–${credits_cloud_hi}"
fi

# --- Plan label ---
plan=$(format_plan_label "$plan_type")
# Also check API response for plan_type
_api_plan=$(jq -r '.plan_type // empty' <<< "$usage" 2>/dev/null) || true
[[ -n "$_api_plan" ]] && plan=$(format_plan_label "$_api_plan")

# --- Pacing ---
# Output: elapsed icon indicator delta pct_label pts_label
_s_pace=$(calc_pacing "$session_pct" "$session_reset_at" "$session_window_s")
read -r session_elapsed session_pace session_pace_indicator session_pace_delta _discard <<< "$_s_pace"
session_pace_pct=$(cut -d' ' -f5-6 <<< "$_s_pace")
session_pace_pts=$(cut -d' ' -f7-8 <<< "$_s_pace")

_w_pace=$(calc_pacing "$weekly_pct" "$weekly_reset_at" "$weekly_window_s")
read -r weekly_elapsed weekly_pace weekly_pace_indicator weekly_pace_delta _discard <<< "$_w_pace"
weekly_pace_pct=$(cut -d' ' -f5-6 <<< "$_w_pace")
weekly_pace_pts=$(cut -d' ' -f7-8 <<< "$_w_pace")

review_elapsed=0 review_pace="" review_pace_indicator="" review_pace_pct="" review_pace_pts="" review_pace_delta="0"
if [[ "$has_review" == "true" ]]; then
    _r_pace=$(calc_pacing "$review_pct" "$review_reset_at" "$review_window_s")
    read -r review_elapsed review_pace review_pace_indicator review_pace_delta _discard <<< "$_r_pace"
    review_pace_pct=$(cut -d' ' -f5-6 <<< "$_r_pace")
    review_pace_pts=$(cut -d' ' -f7-8 <<< "$_r_pace")
fi

# --- Tooltip pace icon (ratio or point-based) ---
if [[ "$TOOLTIP_PACE_PTS" == "true" ]]; then
    _tip_session_pace="$session_pace_indicator"
    _tip_weekly_pace="$weekly_pace_indicator"
    _tip_review_pace="$review_pace_indicator"
else
    _tip_session_pace="$session_pace"
    _tip_weekly_pace="$weekly_pace"
    _tip_review_pace="$review_pace"
fi

# --- Pace colors ---
# Sets _sp_<prefix>_{pace,indicator,pct,pts,delta,abs_delta} for apply_format.
_precompute_pace() {
    local pfx=$1 pace=$2 indicator=$3 pct=$4 pts=$5 delta=$6
    if [[ "$FORMAT_PACE_COLOR" == "true" ]]; then
        local c; c=$(pace_color_for "${delta:-0}")
        printf -v "_sp_${pfx}_pace"      "<span foreground='%s'>%s</span>" "$c" "$pace"
        printf -v "_sp_${pfx}_indicator" "<span foreground='%s'>%s</span>" "$c" "$indicator"
        printf -v "_sp_${pfx}_pct"       "<span foreground='%s'>%s</span>" "$c" "$pct"
        printf -v "_sp_${pfx}_pts"       "<span foreground='%s'>%s</span>" "$c" "$pts"
        printf -v "_sp_${pfx}_delta"     "<span foreground='%s'>%s</span>" "$c" "$delta"
        printf -v "_sp_${pfx}_abs_delta" "<span foreground='%s'>%s</span>" "$c" "${delta#-}"
    else
        printf -v "_sp_${pfx}_pace"      '%s' "$pace"
        printf -v "_sp_${pfx}_indicator" '%s' "$indicator"
        printf -v "_sp_${pfx}_pct"       '%s' "$pct"
        printf -v "_sp_${pfx}_pts"       '%s' "$pts"
        printf -v "_sp_${pfx}_delta"     '%s' "$delta"
        printf -v "_sp_${pfx}_abs_delta" '%s' "${delta#-}"
    fi
}
_precompute_pace session "$session_pace" "$session_pace_indicator" "$session_pace_pct" "$session_pace_pts" "$session_pace_delta"
_precompute_pace weekly  "$weekly_pace"  "$weekly_pace_indicator"  "$weekly_pace_pct"  "$weekly_pace_pts"  "$weekly_pace_delta"
_precompute_pace review  "$review_pace"  "$review_pace_indicator"  "$review_pace_pct"  "$review_pace_pts"  "$review_pace_delta"

# --- Waybar class ---
max_pct=$session_pct
(( weekly_pct > max_pct )) && max_pct=$weekly_pct
(( review_pct > max_pct )) && max_pct=$review_pct
(( additional_max_pct > max_pct )) && max_pct=$additional_max_pct

class=$(severity_for "$max_pct")

# --- Bar text color: the value the bar SHOWS, not the worst one ---
# `class` above is the Waybar CSS class and stays worst-of-all — that is what a
# user styles "critical" on. The bar TEXT is different: tinting a 34% session red
# because a hidden weekly limit is high reports a severity the number beside it
# does not have, and it disagreed with the Omarchy panel, which paints the ramp
# at the percentage it displays. The tint follows whichever window the format
# actually puts on the bar; a maxed-out OTHER window still reaches the user
# through the CSS class, the alarm dot in the panel, and the tooltip.
bar_pct=$session_pct
if [[ "$FORMAT" != *"{session_pct}"* ]]; then
    if   [[ "$FORMAT" == *"{weekly_pct}"* ]]; then bar_pct=$weekly_pct
    elif [[ "$FORMAT" == *"{review_pct}"* ]]; then bar_pct=$review_pct
    fi
fi

# --- Structured JSON output (--json) ---
# Raw data for non-waybar frontends (e.g. the Omarchy shell plugin in
# omarchy/). No Pango, no pre-rendered bars, no colors: presentation is the
# consumer's job. Severity thresholds stay in severity_for so every frontend
# agrees with the waybar classes.

iso8601() {
    local ts=${1:-0}
    if [[ -n "$ts" && "$ts" != "0" && "$ts" != "null" ]]; then
        date -u -d "@$ts" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf 'null'
    else
        printf 'null'
    fi
}

# json_window <id> <label> <group> <used_pct> <reset_at> <window_s> <pace_line>
# pace_line is raw calc_pacing output. Emits one compact JSON object.
json_window() {
    local id=$1 label=$2 group=$3 used=$4 reset_at=$5 window_s=$6 pace_line=$7
    local elapsed icon indicator delta _rest
    read -r elapsed icon indicator delta _rest <<< "$pace_line"
    local pct_label pts_label
    pct_label=$(cut -d' ' -f5-6 <<< "$pace_line")
    pts_label=$(cut -d' ' -f7-8 <<< "$pace_line")
    jq -nc \
        --arg id "$id" --arg label "$label" --arg group "$group" \
        --argjson used "$used" --argjson remaining "$(remaining_pct_for "$used")" \
        --arg reset "$(iso8601 "$reset_at")" --argjson reset_unix "${reset_at:-0}" \
        --argjson window_s "$window_s" --argjson elapsed "$elapsed" \
        --argjson delta "$delta" --arg pace_state "$(pace_severity_for "${delta:-0}")" \
        --arg icon "$icon" --arg indicator "$indicator" \
        --arg ratio_label "$pct_label" --arg points_label "$pts_label" \
        --arg severity "$(severity_for "$used")" \
        '{id:$id, label:$label,
          group:(if $group == "" then null else $group end),
          used_pct:$used, remaining_pct:$remaining,
          reset_at:(if $reset == "null" then null else $reset end),
          reset_at_unix:(if $reset_unix == 0 then null else $reset_unix end),
          window_seconds:$window_s, elapsed_pct:$elapsed,
          pace:{delta_points:$delta, state:$pace_state,
                icon:$icon, indicator:$indicator,
                ratio_label:$ratio_label, points_label:$points_label},
          state:$severity}'
}

if [[ "$JSON_MODE" == "true" ]]; then
    _win_objs=()
    _win_objs+=("$(json_window session "$(main_window_label "$session_window_s" 0)" "" \
        "$session_pct" "$session_reset_at" "$session_window_s" "$_s_pace")")
    # When the API exposes a single weekly window the weekly fields merely
    # mirror the primary one — emitting both would duplicate the same meter.
    if [[ "$has_secondary" == "true" ]]; then
        _win_objs+=("$(json_window weekly "$(main_window_label "$weekly_window_s" 1)" "" \
            "$weekly_pct" "$weekly_reset_at" "$weekly_window_s" "$_w_pace")")
    fi
    if [[ "$has_review" == "true" ]]; then
        _win_objs+=("$(json_window review "Code review" "" \
            "$review_pct" "$review_reset_at" "$review_window_s" "$_r_pace")")
    fi
    if [[ -n "$additional_limits_tsv" ]]; then
        _add_i=0
        while IFS=$'\t' read -r add_name ap_pct ap_reset ap_window as_pct as_reset as_window; do
            [[ -z "${add_name:-}" ]] && continue
            ap_pct=${ap_pct:-0}; ap_reset=${ap_reset:-0}; ap_window=${ap_window:-0}
            as_pct=${as_pct:-0}; as_reset=${as_reset:-0}; as_window=${as_window:-0}
            # Same displayable-window gate as the tooltip and additional_max_pct.
            (( ap_window > 0 || as_window > 0 )) || continue
            if (( ap_window > 0 )); then
                _add_pace=$(calc_pacing "$ap_pct" "$ap_reset" "$ap_window")
                _add_lbl=$(main_window_label "$ap_window" 0)
                _win_objs+=("$(json_window "additional_${_add_i}_primary" "$_add_lbl" "$add_name" \
                    "$ap_pct" "$ap_reset" "$ap_window" "$_add_pace")")
            fi
            if (( as_window > 0 )); then
                _add_pace=$(calc_pacing "$as_pct" "$as_reset" "$as_window")
                _add_lbl=$(main_window_label "$as_window" 1)
                _win_objs+=("$(json_window "additional_${_add_i}_secondary" "$_add_lbl" "$add_name" \
                    "$as_pct" "$as_reset" "$as_window" "$_add_pace")")
            fi
            _add_i=$(( _add_i + 1 ))
        done <<< "$additional_limits_tsv"
    fi
    windows_json=$(printf '%s\n' "${_win_objs[@]}" | jq -cs '.')

    # balance arrives as a string from the API extraction; numbers stay
    # numbers in the structured schema (unparseable -> 0).
    credits_json=$(jq -nc \
        --argjson has "$has_credits" --argjson unlimited "$credits_unlimited" \
        --arg balance "$credits_balance" \
        --argjson local_lo "$credits_local_lo" --argjson local_hi "$credits_local_hi" \
        --argjson cloud_lo "$credits_cloud_lo" --argjson cloud_hi "$credits_cloud_hi" \
        '{has_credits:$has, unlimited:$unlimited,
          balance:(($balance | tonumber?) // 0),
          approx_local_messages:[$local_lo,$local_hi],
          approx_cloud_messages:[$cloud_lo,$cloud_hi]}')

    # Staleness / error info, mirroring the waybar tooltip footer.
    _updated_iso=""
    _age_s=-1
    if [[ -f "$cache_file" ]]; then
        _cache_mtime=$(date -r "$cache_file" +%s)
        _updated_iso=$(iso8601 "$_cache_mtime")
        _age_s=$(( $(date +%s) - _cache_mtime ))
        (( _age_s < 0 )) && _age_s=0
    fi
    _stale=false
    _stale_reason=""
    if [[ "${transient_stale:-false}" == "true" ]]; then
        _stale=true; _stale_reason="network"
    elif [[ -f "$stale_marker" ]]; then
        _stale=true; _stale_reason="error"
    fi
    _last_error_json=null
    if [[ -f "$CACHE_DIR/.last_error" ]]; then
        _le_code="" _le_msg=""
        { read -r _le_code || true; read -r _le_msg || true; } < <(read_bounded "$CACHE_DIR/.last_error" "$FILE_MAX_SECRET") 2>/dev/null || true
        if [[ -n "$_le_code" && "$_le_code" =~ ^[0-9]+$ && "$_le_code" != "000" ]]; then
            _last_error_json=$(jq -nc --argjson c "$_le_code" --arg m "$_le_msg" \
                '{http_status:$c, message:$m}')
        fi
    fi

    # The four severity anchors, already resolved through the same chain the
    # waybar rendering uses (--color-* flags > Omarchy theme > One Dark). The
    # Omarchy panel consumes these so both frontends draw one gauge palette
    # from a single definition, honoring the same overrides.
    # `stops` is the authoritative ramp: colors AND the percentages they sit
    # at, so a threshold change here moves both frontends at once and the panel
    # never re-derives them. The four named keys stay for readability and for
    # any consumer that only wants the anchors.
    palette_json=$(jq -nc \
        --arg low "$BAR_COLOR_LOW" --arg mid "$BAR_COLOR_MID" \
        --arg high "$BAR_COLOR_HIGH" --arg critical "$BAR_COLOR_CRITICAL" \
        --argjson mid_at "$SEVERITY_MID_AT" --argjson high_at "$SEVERITY_HIGH_AT" \
        --argjson crit_at "$SEVERITY_CRITICAL_AT" \
        '{low:$low, mid:$mid, high:$high, critical:$critical,
          stops:[{pct:0, color:$low},
                 {pct:$mid_at, color:$mid},
                 {pct:$high_at, color:$high},
                 {pct:$crit_at, color:$critical},
                 {pct:100, color:$critical}]}')

    jq -nc \
        --arg plan "$plan" --arg state "$class" --argjson max_pct "$max_pct" \
        --argjson windows "$windows_json" --argjson credits "$credits_json" \
        --argjson palette "$palette_json" \
        --argjson stale "$_stale" --arg stale_reason "$_stale_reason" \
        --arg updated "$_updated_iso" --argjson age "$_age_s" \
        --argjson last_error "$_last_error_json" \
        '{schema_version:2, error:null, loading:false,
          plan:$plan, state:$state, max_pct:$max_pct,
          windows:$windows, credits:$credits, palette:$palette,
          stale:$stale,
          stale_reason:(if $stale_reason == "" then null else $stale_reason end),
          updated_at:(if $updated == "" or $updated == "null" then null else $updated end),
          data_age_seconds:(if $age < 0 then null else $age end),
          last_error:$last_error}'
    exit 0
fi

# --- Escape API-supplied strings for Pango ---
# Everything below renders markup, and these two come straight from the API
# response, so a stray & or < would produce invalid markup (Waybar then drops
# the whole label). The structured output above is deliberately escaped-free:
# it carries raw data, and jq handles its own quoting. The per-model meter
# names are escaped at their own render site (pango_escape in the tooltip).
plan=$(pango_escape "$plan")
credits_balance=$(pango_escape "$credits_balance")

# --- Apply format placeholders ---
# Compute countdowns once
s_cd_val=$(countdown "$session_reset_at")
w_cd_val=$(countdown "$weekly_reset_at")
r_cd_val=""
[[ "$has_review" == "true" ]] && r_cd_val=$(countdown "$review_reset_at")

# Per-window colors and bars used by --format / --tooltip-format placeholders.
# Colors are the continuous tint of each window's own usage; usage bars fill
# along the shared per-cell ramp, remaining (drain) bars keep a single tint.
session_color=$(color_for "$session_pct")
weekly_color=$(color_for "$weekly_pct")
review_color=$(color_for "$review_pct")
format_session_bar=$(make_bar "$session_pct" gradient)
format_weekly_bar=$(make_bar "$weekly_pct" gradient)
format_review_bar=$(make_bar "$review_pct" gradient)
format_session_remaining_bar=$(make_bar "$session_remaining_pct" "$session_color")
format_weekly_remaining_bar=$(make_bar "$weekly_remaining_pct" "$weekly_color")
format_review_remaining_bar=$(make_bar "$review_remaining_pct" "$review_color")

apply_format() {
    local text="$1"
    text="${text//\{icon\}/󱙺}"
    text="${text//\{plan\}/$plan}"
    text="${text//\{session_pct\}/$session_pct}"
    text="${text//\{session_remaining_pct\}/$session_remaining_pct}"
    text="${text//\{session_reset\}/$s_cd_val}"
    text="${text//\{session_elapsed\}/$session_elapsed}"
    text="${text//\{weekly_pct\}/$weekly_pct}"
    text="${text//\{weekly_remaining_pct\}/$weekly_remaining_pct}"
    text="${text//\{weekly_reset\}/$w_cd_val}"
    text="${text//\{weekly_elapsed\}/$weekly_elapsed}"
    text="${text//\{review_pct\}/$review_pct}"
    text="${text//\{review_remaining_pct\}/$review_remaining_pct}"
    text="${text//\{review_reset\}/$r_cd_val}"
    text="${text//\{review_elapsed\}/$review_elapsed}"
    text="${text//\{credits_balance\}/$credits_balance}"
    text="${text//\{credits_local\}/$credits_local}"
    text="${text//\{credits_cloud\}/$credits_cloud}"
    text="${text//\{session_bar\}/$format_session_bar}"
    text="${text//\{weekly_bar\}/$format_weekly_bar}"
    text="${text//\{review_bar\}/$format_review_bar}"
    text="${text//\{session_remaining_bar\}/$format_session_remaining_bar}"
    text="${text//\{weekly_remaining_bar\}/$format_weekly_remaining_bar}"
    text="${text//\{review_remaining_bar\}/$format_review_remaining_bar}"

    # Pace placeholders — pre-computed colored or plain depending on --format-pace-color.
    text="${text//\{session_pace_indicator\}/$_sp_session_indicator}"
    text="${text//\{session_pace_abs_delta\}/$_sp_session_abs_delta}"
    text="${text//\{session_pace_delta\}/$_sp_session_delta}"
    text="${text//\{session_pace_pct\}/$_sp_session_pct}"
    text="${text//\{session_pace_pts\}/$_sp_session_pts}"
    text="${text//\{session_pace\}/$_sp_session_pace}"
    text="${text//\{weekly_pace_indicator\}/$_sp_weekly_indicator}"
    text="${text//\{weekly_pace_abs_delta\}/$_sp_weekly_abs_delta}"
    text="${text//\{weekly_pace_delta\}/$_sp_weekly_delta}"
    text="${text//\{weekly_pace_pct\}/$_sp_weekly_pct}"
    text="${text//\{weekly_pace_pts\}/$_sp_weekly_pts}"
    text="${text//\{weekly_pace\}/$_sp_weekly_pace}"
    text="${text//\{review_pace_indicator\}/$_sp_review_indicator}"
    text="${text//\{review_pace_abs_delta\}/$_sp_review_abs_delta}"
    text="${text//\{review_pace_delta\}/$_sp_review_delta}"
    text="${text//\{review_pace_pct\}/$_sp_review_pct}"
    text="${text//\{review_pace_pts\}/$_sp_review_pts}"
    text="${text//\{review_pace\}/$_sp_review_pace}"

    printf '%s' "$text"
}

# Stale data indicator
stale_icon=""
[[ -f "$stale_marker" || "${transient_stale:-false}" == "true" ]] && stale_icon=" "   # nf-fa-pause (U+23F8 renders as a color emoji)

bar_text=$(apply_format "$FORMAT")${stale_icon}

# --- Colorize bar text via Pango ---
# Continuous tint of the value ON the bar; the JSON `class` field stays discrete
# and worst-of-all, which is what lets users style the bar from their own CSS.
bar_fg=$(color_for "$bar_pct")
if [[ "$COLOR_BAR" != "true" ]]; then
    # Monochrome bar: no wrapper span, and any color a --format placeholder
    # injected (bars, pace) is stripped. Glyphs and layout are untouched.
    bar_text="${BAR_ICON:+${BAR_ICON} }${bar_text}"
    bar_text=$(printf '%s' "$bar_text" | decolor)
elif [[ "$FORMAT_PACE_COLOR" == "true" && "$FORMAT" == *_pace* ]]; then
    # Neutral base; pace placeholders provide their own color
    bar_text="<span foreground='${FG}'>${BAR_ICON:+${BAR_ICON} }${bar_text}</span>"
else
    bar_text="<span foreground='${bar_fg}'>${BAR_ICON:+${BAR_ICON} }${bar_text}</span>"
fi

# --- Stale status note ---
# One explicit line saying WHY the ⏸ is shown and how old the data is. Used as
# the footer of the default tooltip and appended to custom tooltips (precedent:
# the ⏸ icon is already appended outside custom --format).
_updated="—"
_data_age=""
if [[ -f "$cache_file" ]]; then
    _updated=$(date -r "$cache_file" +%H:%M)
    _data_age=$(rel_age $(( $(date +%s) - $(date -r "$cache_file" +%s) )))
fi
_stale_note=""
# Suffix for the freshness footer. The footer always says when the data is
# from; this only adds WHY it is not fresh, in the same words the Omarchy shell
# panel uses.
_stale_suffix=""
if [[ "${transient_stale:-false}" == "true" ]]; then
    _stale_note="  Waiting for network — data from ${_updated}${_data_age:+ (${_data_age})}"
    _stale_suffix="<span foreground='${ORANGE}'> · stale (waiting for network)</span>"
elif [[ -f "$stale_marker" ]]; then
    _stale_note="  Stale — data from ${_updated}${_data_age:+ (${_data_age})}"
    _stale_suffix="<span foreground='${ORANGE}'> · stale (API errors)</span>"
fi

# --- Tooltip ---
if [[ -n "$TOOLTIP_FORMAT" ]]; then
    t=$(apply_format "$TOOLTIP_FORMAT")
    [[ -n "$_stale_note" ]] && t+=$'\n'"<span foreground='${ORANGE}'>${_stale_note}</span>"
else
    # Default rich Pango tooltip. The meters are parked and resolved after the
    # width pass — refer to add_meter below.
    s_cd="$s_cd_val"
    w_cd="$w_cd_val"

    NL=$'\n'
    B="<span foreground='${BLUE}'>"
    E="</span>"

    strip_tags() { sed 's/<[^>]*>//g' <<< "$1"; }

    # --- The meter row spans the tooltip ---------------------------------
    # A meter row is <indent><bar><gap><value>, and the value is right-aligned
    # on the tooltip's inner width — the same column the longest text line
    # ends on. The bar length therefore depends on the WIDEST line, which is
    # not known while the lines are still being collected. So a meter parks a
    # placeholder in `lines` plus one entry in the parallel arrays below, and
    # the resolution happens after the width pass.
    #
    # Parallel arrays, not one packed token: the value labels and colors are
    # markup-adjacent, and splitting a packed record back apart in bash is one
    # quoting bug waiting to happen.
    TIP_IND=3           # spaces before the bar
    TIP_VAL=6           # value column, wide enough for "100% ↑"
    TIP_GAP_MIN=2       # smallest gap between the bar and the value
    TIP_BAR_MIN=20      # a short tooltip still gets a readable bar
    TIP_BAR_MAX=48      # one long line must not stretch the bar into a ruler
    meter_pct=() meter_elapsed=() meter_color=() meter_label=()
    add_meter() {  # add_meter <pct> <elapsed> <value_color> <value_label>
        meter_pct+=("$1"); meter_elapsed+=("$2")
        meter_color+=("$3"); meter_label+=("$4")
        lines+=("METER:$(( ${#meter_pct[@]} - 1 ))")
    }

    # Collect all content lines into an array
    lines=()
    _tip_title="Codex ${plan}"
    [[ "$REMAINING" == "true" ]] && _tip_title="${_tip_title} · Remaining"
    lines+=("CENTER<span font_weight='bold' foreground='${BLUE}'>${_tip_title}</span>")
    lines+=("SEP")
    lines+=("")
    session_label=$(main_window_label "$session_window_s" 0)
    lines+=(" <span foreground='${FG}'>  $(main_window_icon "$session_label")  ${session_label}</span>")
    _lbl_s="$(display_pct "$session_pct")%"
    add_meter "$session_pct" "$session_elapsed" "$session_color" "$_lbl_s"
    lines+=(" <span foreground='${DIM}'>  󰥔  Resets in ${s_cd}</span><span foreground='${DIM}'>  ·  ${session_pace_indicator} ${session_pace_pts}</span>")
    if [[ "$has_secondary" == "true" ]]; then
        weekly_label=$(main_window_label "$weekly_window_s" 1)
        lines+=("")
        lines+=(" <span foreground='${FG}'>  $(main_window_icon "$weekly_label")  ${weekly_label}</span>")
        _lbl_w="$(display_pct "$weekly_pct")%"
        add_meter "$weekly_pct" "$weekly_elapsed" "$weekly_color" "$_lbl_w"
        lines+=(" <span foreground='${DIM}'>  󰥔  Resets in ${w_cd}</span><span foreground='${DIM}'>  ·  ${weekly_pace_indicator} ${weekly_pace_pts}</span>")
    fi

    if [[ "$has_review" == "true" ]]; then
        r_cd=$(countdown "$review_reset_at")
        lines+=("")
        lines+=(" <span foreground='${FG}'>  󰑕  Code review</span>")
        _lbl_r="$(display_pct "$review_pct")%"
        add_meter "$review_pct" "$review_elapsed" "$review_color" "$_lbl_r"
        lines+=(" <span foreground='${DIM}'>  󰥔  Resets in ${r_cd}</span><span foreground='${DIM}'>  ·  ${review_pace_indicator} ${review_pace_pts}</span>")
    fi

    if [[ -n "$additional_limits_tsv" ]]; then
        while IFS=$'\t' read -r add_name add_primary_pct add_primary_reset add_primary_window add_secondary_pct add_secondary_reset add_secondary_window; do
            [[ -z "${add_name:-}" ]] && continue
            add_primary_pct=${add_primary_pct:-0}
            add_primary_reset=${add_primary_reset:-0}
            add_primary_window=${add_primary_window:-0}
            add_secondary_pct=${add_secondary_pct:-0}
            add_secondary_reset=${add_secondary_reset:-0}
            add_secondary_window=${add_secondary_window:-0}

            # Only render (and thus count toward severity) meters with a displayable
            # window. additional_max_pct applies the same gate, so the worst-case
            # color can never come from a meter the tooltip doesn't show.
            (( add_primary_window > 0 || add_secondary_window > 0 )) || continue

            lines+=("")
            lines+=("SEP")
            lines+=(" <span foreground='${FG}'>  󱐌  $(pango_escape "$add_name")</span>")

            if (( add_primary_window > 0 )); then
                _add_primary_pace=$(calc_pacing "$add_primary_pct" "$add_primary_reset" "$add_primary_window")
                read -r add_primary_elapsed add_primary_pace add_primary_indicator _discard <<< "$_add_primary_pace"
                add_primary_pts=$(cut -d' ' -f7-8 <<< "$_add_primary_pace")
                if [[ "$TOOLTIP_PACE_PTS" == "true" ]]; then
                    add_primary_tip_pace="$add_primary_indicator"
                else
                    add_primary_tip_pace="$add_primary_pace"
                fi
                add_primary_label=$(main_window_label "$add_primary_window" 0)
                lines+=("")
                lines+=(" <span foreground='${FG}'>  󰔟  ${add_primary_label}</span>")
                _lbl_ap="$(display_pct "$add_primary_pct")%"
                add_meter "$add_primary_pct" "$add_primary_elapsed" "$(color_for "$add_primary_pct")" "$_lbl_ap"
                lines+=(" <span foreground='${DIM}'>  󰥔  Resets in $(countdown "$add_primary_reset")</span><span foreground='${DIM}'>  ·  ${add_primary_indicator} ${add_primary_pts}</span>")
            fi

            if (( add_secondary_window > 0 )); then
                _add_secondary_pace=$(calc_pacing "$add_secondary_pct" "$add_secondary_reset" "$add_secondary_window")
                read -r add_secondary_elapsed add_secondary_pace add_secondary_indicator _discard <<< "$_add_secondary_pace"
                add_secondary_pts=$(cut -d' ' -f7-8 <<< "$_add_secondary_pace")
                if [[ "$TOOLTIP_PACE_PTS" == "true" ]]; then
                    add_secondary_tip_pace="$add_secondary_indicator"
                else
                    add_secondary_tip_pace="$add_secondary_pace"
                fi
                add_secondary_label=$(main_window_label "$add_secondary_window" 1)
                lines+=("")
                lines+=(" <span foreground='${FG}'>  󰃰  ${add_secondary_label}</span>")
                _lbl_as="$(display_pct "$add_secondary_pct")%"
                add_meter "$add_secondary_pct" "$add_secondary_elapsed" "$(color_for "$add_secondary_pct")" "$_lbl_as"
                lines+=(" <span foreground='${DIM}'>  󰥔  Resets in $(countdown "$add_secondary_reset")</span><span foreground='${DIM}'>  ·  ${add_secondary_indicator} ${add_secondary_pts}</span>")
            fi
        done <<< "$additional_limits_tsv"
    fi

    if [[ "$has_credits" == "true" ]]; then
        lines+=("")
        lines+=("SEP")
        lines+=(" <span foreground='${FG}'>  󰄑  Credits balance</span>  <span font_weight='bold' foreground='${FG}'>${credits_balance}</span>")
        if [[ "$credits_local" != "0" ]]; then
            lines+=(" <span foreground='${DIM}'>  󰀓  Local msgs: ~${credits_local}</span>")
        fi
        if [[ "$credits_cloud" != "0" ]]; then
            lines+=(" <span foreground='${DIM}'>  󰏗  Cloud msgs: ~${credits_cloud}</span>")
        fi
    fi

    # API error info (if stale)
    if [[ -f "$CACHE_DIR/.last_error" ]]; then
        _le_code="" _le_msg=""
        { read -r _le_code || true; read -r _le_msg || true; } < <(read_bounded "$CACHE_DIR/.last_error" "$FILE_MAX_SECRET") 2>/dev/null || true
        if [[ -n "$_le_code" ]] && [[ "$_le_code" =~ ^[0-9]+$ ]] && [[ "$_le_code" != "000" ]]; then
            _le_msg=$(sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<< "$_le_msg")
            if (( _le_code >= 500 )); then
                _err_icon="󰅚" _err_color="$RED"
            else
                _err_icon="󰀪" _err_color="$ORANGE"
            fi
            lines+=("")
            lines+=("SEP")
            _err_line=" <span foreground='${_err_color}'>  ${_err_icon}  HTTP ${_le_code}</span>"
            lines+=("$_err_line")
            if [[ -n "$_le_msg" ]]; then
                _wbuf=""
                for _wword in $_le_msg; do
                    if [[ -z "$_wbuf" ]]; then
                        _wbuf="$_wword"
                    elif (( ${#_wbuf} + 1 + ${#_wword} <= 35 )); then
                        _wbuf+=" $_wword"
                    else
                        lines+=("     <span foreground='${DIM}'>${_wbuf}</span>")
                        _wbuf="$_wword"
                    fi
                done
                [[ -n "$_wbuf" ]] && lines+=("     <span foreground='${DIM}'>${_wbuf}</span>")
            fi
        fi
    fi

    # Footer: the house freshness line — separator rule, clock glyph,
    # "Updated HH:MM", and a "· stale (...)" suffix only when the data is not
    # fresh. Identical shape in the Omarchy shell panel and in every sibling
    # widget, so a reader learns it once. The blank line above the rule is this
    # tooltip's own section rhythm (every section is preceded by one).
    lines+=("")
    lines+=("SEP")
    lines+=(" <span foreground='${DIM}'>  󰅐  Updated ${_updated}</span>${_stale_suffix}")

    # Calculate max width from content
    # The meters are skipped: their width is DERIVED from this number, so
    # measuring them here would be circular.
    max_w=0
    for line in "${lines[@]}"; do
        [[ "$line" == "SEP" || "$line" == METER:* ]] && continue
        [[ "$line" == CENTER* ]] && line="${line#CENTER}"
        plain=$(strip_tags "$line")
        (( ${#plain} > max_w )) && max_w=${#plain}
    done
    INNER_W=$(( max_w + 1 ))

    # ONE bar length for the whole tooltip. The meters stack, so a reader
    # compares them against each other; a per-row length would turn that
    # comparison into a lie.
    #
    # A rule carries one leading space and INNER_W-2 cells, so it ends on
    # column INNER_W-1. THAT column is the tooltip's right edge, and the value
    # has to land on it — not on INNER_W, which nothing else reaches.
    tip_right=$(( INNER_W - 1 ))
    tip_bar_len=$(( tip_right - TIP_IND - TIP_GAP_MIN - TIP_VAL ))
    (( tip_bar_len < TIP_BAR_MIN )) && tip_bar_len=$TIP_BAR_MIN
    (( tip_bar_len > TIP_BAR_MAX )) && tip_bar_len=$TIP_BAR_MAX
    # A clamp at the low end makes the meter row wider than every text line, so
    # the rules grow to match it and the right edge stays one straight line.
    _row_w=$(( TIP_IND + tip_bar_len + TIP_GAP_MIN + TIP_VAL ))
    if (( _row_w > tip_right )); then tip_right=$_row_w; INNER_W=$(( tip_right + 1 )); fi

    # make_bar reads BAR_LEN. The bar TEXT is already built at this point, so
    # the tooltip is free to move it.
    BAR_LEN=$tip_bar_len

    # Resolve the parked meters now that the geometry is known.
    printf -v _tip_ind '%*s' "$TIP_IND" ''
    _tip_marker=""; [[ "$TOOLTIP_PACE_PTS" == "true" ]] && _tip_marker=marker
    for _mi_r in "${!lines[@]}"; do
        [[ "${lines[$_mi_r]}" == METER:* ]] || continue
        _m=${lines[$_mi_r]#METER:}
        _mbar=$(display_bar "${meter_pct[$_m]}" "${meter_elapsed[$_m]}" $_tip_marker)
        _mlbl="${meter_label[$_m]}"
        # The gap absorbs the label's own width, so the LAST character of the
        # value lands on the right edge whatever the label says.
        _mpad=$(( tip_right - TIP_IND - tip_bar_len - ${#_mlbl} ))
        (( _mpad < 1 )) && _mpad=1
        printf -v _mgap '%*s' "$_mpad" ''
        lines[$_mi_r]="${_tip_ind}${_mbar}${_mgap}<span font_weight='bold' foreground='${meter_color[$_m]}'>${_mlbl}</span>"
    done

    # Build separator dynamically
    sep=""
    printf -v sep '%*s' "$(( INNER_W - 2 ))" ''; sep="${sep// /─}"
    sep=" <span foreground='${DIM}'>${sep}</span>"

    # Una sola forma de tooltip, con la fuente fijada.
    #
    # El pin no es decoración: las reglas están hechas de ─, y en una fuente
    # proporcional ese carácter mide casi el doble que una letra. El tooltip
    # entonces se dimensiona por las reglas y le queda un margen muerto a la
    # derecha del texto. Waybar renderiza el tooltip en una ventana GTK que
    # IGNORA font-family del CSS, así que el markup es el único lugar donde
    # esto se puede decir.
    t=""
    for line in "${lines[@]}"; do
        if [[ "$line" == "SEP" ]]; then
            t+="${sep}${NL}"
        elif [[ "$line" == CENTER* ]]; then
            # Leading space aligns the title with the rule and section headers.
            t+=" ${line#CENTER}${NL}"
        else
            t+="${line}${NL}"
        fi
    done
    t="${t%"$NL"}"
    _tf=$(sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/'"'"'/\&apos;/g' <<< "$TOOLTIP_FONT")
    t="<span font_family='${_tf}'>${t}</span>"
fi

# Monochrome tooltip: same structure (glyphs, bars, markers, box drawing,
# alignment, font attributes), just no color attributes.
[[ "$COLOR_TOOLTIP" == "true" ]] || t=$(printf '%s' "$t" | decolor)

# --- Output waybar JSON ---
jq -nc --arg text "$bar_text" --arg tooltip "$t" --arg class "$class" \
    '{text:$text, tooltip:$tooltip, class:$class}'
